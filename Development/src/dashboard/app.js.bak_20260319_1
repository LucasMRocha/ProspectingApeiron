function cityStateFromLead(lead) {
  const city = text(lead.accountCity).trim();
  const state = text(lead.accountState).trim();
  if (city && state) return `${city}/${state}`;
  if (city || state) return city || state;
  return text(lead.accountCityState || lead.location).trim();
}

function splitCityState(rawValue) {
  const raw = text(rawValue).trim();
  if (!raw) return { city: "", state: "" };
  if (raw.includes("/")) {
    const [city, state] = raw.split("/");
    return { city: text(city).trim(), state: text(state).trim() };
  }
  if (raw.includes(",")) {
    const [city, state] = raw.split(",");
    return { city: text(city).trim(), state: text(state).trim() };
  }
  return { city: raw, state: "" };
}

function composeCityState(city, state) {
  const c = text(city).trim();
  const s = text(state).trim();
  if (c && s) return `${c}/${s}`;
  return c || s;
}

function normalizePhoneDigits(value) {
  return text(value).replace(/\D/g, "");
}

function pickFirst(arr) {
  if (!Array.isArray(arr)) return "";
  for (const v of arr) {
    const t = text(v).trim();
    if (t) return t;
  }
  return "";
}

function uniqValues(arr) {
  const seen = new Set();
  const out = [];
  (arr || []).forEach((item) => {
    const v = text(item).trim();
    const key = norm(v);
    if (!v || seen.has(key)) return;
    seen.add(key);
    out.push(v);
  });
  return out;
}

function channelSetFromContactFields(fields) {
  const channels = new Set();
  if (text(fields.email).trim()) channels.add("Email");
  if (text(fields.phone).trim()) channels.add("Phone");
  if (text(fields.linkedin).trim()) channels.add("LinkedIn");
  return channels;
}

function toTitleCase(value) {
  const raw = text(value).trim();
  if (!raw) return "";
  return raw
    .toLowerCase()
    .split(/\s+/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function nextLeadId() {
  const maxId = leads.reduce((acc, item) => {
    const id = Number(item.id);
    return Number.isFinite(id) ? Math.max(acc, id) : acc;
  }, 0);
  return maxId + 1;
}

function sanitizeColumnOrder(rawOrder) {
  const incoming = Array.isArray(rawOrder) ? rawOrder.map((x) => text(x).trim()) : [];
  const used = new Set();
  const out = [];
  incoming.forEach((key) => {
    if (!TABLE_COLUMN_KEYS.includes(key) || used.has(key)) return;
    used.add(key);
    out.push(key);
  });
  TABLE_COLUMN_KEYS.forEach((key) => {
    if (used.has(key)) return;
    out.push(key);
  });
  return out;
}

function getActiveColumnOrder() {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  return sanitizeColumnOrder(columnOrderByMode[mode] || DEFAULT_COLUMN_ORDER_BY_MODE[mode]);
