async function callAiRuntimeHelper(path, payload = null, timeoutMs = AI_RUNTIME_HELPER_TIMEOUT_MS) {
  if (typeof fetch !== "function") throw new Error("fetch_not_available");
  const controller = typeof AbortController === "function" ? new AbortController() : null;
  const timer = controller ? setTimeout(() => controller.abort(), timeoutMs) : null;
  try {
    const opts = {
      method: payload ? "POST" : "GET",
      headers: payload ? { "Content-Type": "application/json" } : undefined,
      body: payload ? JSON.stringify(payload) : undefined,
      signal: controller ? controller.signal : undefined,
    };
    const resp = await fetch(`${AI_RUNTIME_HELPER_BASE}${path}`, opts);
    if (!resp.ok) {
      const body = await resp.text().catch(() => "");
      throw new Error(`helper_http_${resp.status}:${body.slice(0, 180)}`);
    }
    return await resp.json();
  } finally {
    if (timer) clearTimeout(timer);
  }
}

async function ensureLocalAiRuntime(mode = "ai") {
  try {
    const payload = await callAiRuntimeHelper("/prepare", { mode });
    if (payload && payload.ok) return payload;
    throw new Error("helper_unexpected_payload");
  } catch (error) {
    logPerf("AI helper unavailable", { mode, error: text(error?.message || error) });
    return null;
  }
}

