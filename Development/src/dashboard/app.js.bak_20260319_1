function readViewFiltersFromDom() {
  const out = {};
  VIEW_FILTER_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    out[id] = text(el.value);
  });
  return out;
}

function applyViewFiltersToDom(filters) {
  if (!filters || typeof filters !== "object") return;
  VIEW_FILTER_IDS.forEach((id) => {
    if (!Object.prototype.hasOwnProperty.call(filters, id)) return;
    const el = document.getElementById(id);
    if (!el) return;
    el.value = text(filters[id]);
  });
}

function loadViewPreferences() {
  try {
    const raw = localStorage.getItem(VIEW_KEY);
    if (!raw) return;
    const saved = JSON.parse(raw);
    if (!saved || typeof saved !== "object") return;

    if (saved.operationalMode === "contacts" || saved.operationalMode === "companies") {
      operationalMode = saved.operationalMode;
    }
    const savedRows = Number(saved.pageSize);
    if (Number.isFinite(savedRows)) pageSize = savedRows;

    if (saved.columnOrderByMode && typeof saved.columnOrderByMode === "object") {
      if (Array.isArray(saved.columnOrderByMode.contacts)) {
        columnOrderByMode.contacts = sanitizeColumnOrder(saved.columnOrderByMode.contacts);
      }
      if (Array.isArray(saved.columnOrderByMode.companies)) {
        columnOrderByMode.companies = sanitizeColumnOrder(saved.columnOrderByMode.companies);
      }
    }
    if (saved.columnWidthByMode && typeof saved.columnWidthByMode === "object") {
      const normalizeMap = (raw) => {
        const out = {};
        if (!raw || typeof raw !== "object") return out;
        TABLE_COLUMN_KEYS.forEach((key) => {
          const width = Number(raw[key]);
          if (Number.isFinite(width) && width >= MIN_COLUMN_WIDTH) out[key] = Math.round(width);
        });
        return out;
      };
      columnWidthByMode = {
        contacts: normalizeMap(saved.columnWidthByMode.contacts),
        companies: normalizeMap(saved.columnWidthByMode.companies),
      };
    }
    if (saved.hiddenColumnsByMode && typeof saved.hiddenColumnsByMode === "object") {
      hiddenColumnsByMode = {
        contacts: sanitizeHiddenColumns(saved.hiddenColumnsByMode.contacts),
        companies: sanitizeHiddenColumns(saved.hiddenColumnsByMode.companies),
      };
    }

    if (TABLE_SORT_KEYS.includes(saved.sortKey)) {
      sortKey = saved.sortKey;
    }
    if (saved.sortDir === 1 || saved.sortDir === -1) {
      sortDir = saved.sortDir;
    } else {
      sortDir = 0;
    }
    onlyOverdue = saved.onlyOverdue === true;
    if (saved.filters && typeof saved.filters === "object") {
      restoredViewFilters = saved.filters;
    }
  } catch (_) {}
}

function saveViewPreferences(silent = false) {
  const payload = {
    operationalMode,
    pageSize,
    sortKey,
    sortDir,
    onlyOverdue,
    filters: readViewFiltersFromDom(),
    columnOrderByMode: {
      contacts: sanitizeColumnOrder(columnOrderByMode.contacts),
      companies: sanitizeColumnOrder(columnOrderByMode.companies),
    },
    columnWidthByMode: {
      contacts: getColumnWidthsForMode("contacts"),
      companies: getColumnWidthsForMode("companies"),
    },
    hiddenColumnsByMode: {
      contacts: sanitizeHiddenColumns(hiddenColumnsByMode.contacts),
      companies: sanitizeHiddenColumns(hiddenColumnsByMode.companies),
    },
  };
  localStorage.setItem(VIEW_KEY, JSON.stringify(payload));
  if (!silent) setMsg("View saved successfully.", "#1e8449");
}

