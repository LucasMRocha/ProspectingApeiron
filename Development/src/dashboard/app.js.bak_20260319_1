  const toggleEl = document.getElementById("btnCompanyRankingToggle");
  if (!listEl || !subEl) return;

  const activeLeads = (data || []).filter(isOpenLead);
  if (!activeLeads.length) {
    subEl.textContent = "No active companies in current filters";
    listEl.innerHTML = '<div class="ranking-empty">No active records match current filters.</div>';
    setRankingToggleState(toggleEl, companyRankingExpanded, 0);
    return;
  }
  const grouped = new Map();
  activeLeads.forEach((lead) => {
    const companyName = text(lead.company).trim() || "Unnamed Company";
    const key = norm(companyName) || `company-${lead.id}`;
    if (!grouped.has(key)) grouped.set(key, { company: companyName, leads: [] });
    grouped.get(key).leads.push(lead);
  });

  const ranked = [...grouped.values()]
    .map((group) => {
      const leadsByUrgency = [...group.leads].sort(
        (a, b) => daysUntilDate(a.nextActionDate) - daysUntilDate(b.nextActionDate) || Number(a.id || 0) - Number(b.id || 0)
      );
      const best = leadsByUrgency[0];
      const nextDate = earliestDateText(group.leads.map((lead) => lead.nextActionDate));
      const segment = firstNonEmpty(group.leads, "accountSector") || "-";
      const briefing = firstNonEmpty(group.leads, "accountSummary");
      const topContact = text(best?.name).trim() || "-";
      const score = scoreCompanyGroup(group.leads);
      return {
        company: group.company,
        contacts: group.leads.length,
        topContact,
        segment,
        score,
        label: rankingLabel(score),
        nextDate,
        briefing,
      };
    })
    .sort((a, b) => b.score - a.score || b.contacts - a.contacts || a.company.localeCompare(b.company, "en", { sensitivity: "base" }))
    .slice(0, 9999);

  const visibleCount = companyRankingExpanded ? ranked.length : Math.min(RANKING_DEFAULT_VISIBLE, ranked.length);
  subEl.textContent = `${visibleCount} of ${ranked.length} companies shown`;
  listEl.innerHTML = `<div class="ranking-item ranking-header">
      <div>Company</div>
      <div>Segment</div>
      <div>Score</div>
      <div>Briefing</div>
    </div>` + ranked
    .slice(0, visibleCount)
    .map(
      (item) => `
      <div class="ranking-item">
        <div>
          <div class="ranking-company">${escHtml(item.company)}</div>
          <div class="ranking-meta">${item.contacts} open lead(s) - Top contact: ${escHtml(item.topContact)}</div>
        </div>
        <div class="ranking-segment">${escHtml(item.segment)}</div>
        <div><span class="rank-badge ${escAttr(item.label.toLowerCase())}">${escHtml(item.label)} ${item.score}</span></div>
        <div class="ranking-briefing">${escHtml(item.briefing || "No briefing yet")}</div>
      </div>`
    )
    .join("");
  setRankingToggleState(toggleEl, companyRankingExpanded, ranked.length);
}

