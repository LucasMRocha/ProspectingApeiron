}

function exportCsv() {
  const cols = ["id", "company", "cityState", "name", "role", "status", "priority", "createdDate", "nextAction", "nextActionDate", "channel", "owner", "source"];
  const lines = [cols.join(",")].concat(
    filtered().map((l) =>
      cols
        .map((k) => {
          const value = k === "cityState" ? cityStateFromLead(l) : l[k];
          return `"${text(value).replaceAll('"', '""')}"`;
        })
        .join(",")
    )
  );
  const blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8;" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "apeiron_operations_en.csv";
  a.click();
}

function headerMap(sheet, headerRow) {
  const map = {};
  for (let c = 1; c <= 120; c += 1) {
    const v = sheet.cell(headerRow, c).value();
    if (v !== undefined && v !== null && text(v).trim() !== "") map[text(v).trim()] = c;
  }
  return map;
}

function findCol(headers, names) {
  for (const name of names) if (headers[name]) return headers[name];
  return null;
}

function setv(sheet, row, col, value) {
  if (!col) return;
  sheet.cell(row, col).value(value === undefined || value === null ? "" : value);
}

function writeLeadToSheetRow(sheet, row, headers, lead) {
  const chSet = parseChannelSet(lead.channel);
  setv(sheet, row, findCol(headers, ["ID"]), lead.id);
  setv(sheet, row, findCol(headers, ["Name"]), lead.name);
  setv(sheet, row, findCol(headers, ["Company"]), lead.company);
  setv(sheet, row, findCol(headers, ["Role"]), lead.role);
  setv(sheet, row, findCol(headers, ["Department"]), lead.department);
  setv(sheet, row, findCol(headers, ["Email"]), lead.email);
  setv(sheet, row, findCol(headers, ["Phone"]), lead.phone);
  setv(sheet, row, findCol(headers, ["LinkedIn"]), lead.linkedin);
  setv(sheet, row, findCol(headers, ["Location"]), lead.location);
  setv(sheet, row, findCol(headers, ["Status"]), lead.status);
  setv(sheet, row, findCol(headers, ["Priority"]), lead.priority);
  setv(sheet, row, findCol(headers, ["Channel", "Contact Channel"]), formatChannelLabel(lead.channel));
  setv(sheet, row, findCol(headers, ["Channel Email"]), chSet.has("Email") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel Phone"]), chSet.has("Phone") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel LinkedIn"]), chSet.has("LinkedIn") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel WhatsApp"]), chSet.has("WhatsApp") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Next Action"]), lead.nextAction);
  setv(sheet, row, findCol(headers, ["Next Action Date"]), lead.nextActionDate);
  setv(sheet, row, findCol(headers, ["Created Date"]), lead.createdDate);
  setv(sheet, row, findCol(headers, ["Lead Insight", "Owner", "Vendedor"]), lead.owner);
  setv(sheet, row, findCol(headers, ["Source"]), lead.source);
  setv(sheet, row, findCol(headers, ["Notes"]), lead.notes);
  setv(sheet, row, findCol(headers, ["Account_Brand", "Brand", "Marca"]), lead.accountBrand);
  setv(sheet, row, findCol(headers, ["Account_Summary"]), lead.accountSummary);
  setv(sheet, row, findCol(headers, ["Account_Sector"]), lead.accountSector);
  setv(sheet, row, findCol(headers, ["Account_City", "Account City"]), lead.accountCity);
  setv(sheet, row, findCol(headers, ["Account_State", "Account State"]), lead.accountState);
  setv(sheet, row, findCol(headers, ["Account_City_State"]), lead.accountCityState);
  setv(sheet, row, findCol(headers, ["Account_Size"]), lead.accountSize);
  setv(sheet, row, findCol(headers, ["Account_Revenue"]), lead.accountRevenue);
  setv(sheet, row, findCol(headers, ["Account_Website"]), lead.accountWebsite);
  setv(sheet, row, findCol(headers, ["Account_Phone"]), lead.accountPhone);
  setv(sheet, row, findCol(headers, ["Account_CNPJ", "CNPJ"]), lead.accountCnpj);
}

function updateById(sheet, headerRow, leadMap, options = {}) {
  const headers = headerMap(sheet, headerRow);
  const idCol = findCol(headers, ["ID"]);
  if (!idCol) return 0;
  const appendMissing = options.appendMissing === true;

  const used = sheet.usedRange();
  const maxRow = used ? used.endCell().rowNumber() : headerRow + 1;
  let updated = 0;
  let appended = 0;
  const existingIds = new Set();

  for (let r = headerRow + 1; r <= maxRow; r += 1) {
    const id = Number(sheet.cell(r, idCol).value());
    if (!Number.isFinite(id)) continue;
    existingIds.add(id);
    const lead = leadMap.get(id);
    if (!lead) continue;
    writeLeadToSheetRow(sheet, r, headers, lead);
    updated += 1;
  }

  if (appendMissing) {
    const missingLeads = [...leadMap.values()]
      .filter((lead) => Number.isFinite(Number(lead.id)) && !existingIds.has(Number(lead.id)))
      .sort((a, b) => Number(a.id) - Number(b.id));
    let targetRow = maxRow + 1;
    missingLeads.forEach((lead) => {
      writeLeadToSheetRow(sheet, targetRow, headers, lead);
      targetRow += 1;
      appended += 1;
    });
  }

  return updated + appended;
}

function isObjectValue(value) {
  return typeof value === "object" && value !== null;
}

function formatIsoDate(rawValue) {
  const dt = normalizeDate(rawValue);
  return dt ? dt.toISOString().slice(0, 10) : "";
}

function normalizeTextForPersistence(field, rawValue) {
  if (rawValue === undefined || rawValue === null) return "";
  if (isObjectValue(rawValue)) return "";
  const multiline = field === "notes" || field === "accountSummary";
  return sanitizeModalInputValue(field, rawValue, { multiline });
}

function normalizeLeadForPersistence(lead, errors) {
  const idNum = Number(lead?.id);
  if (!Number.isFinite(idNum) || idNum <= 0) {
    errors.push({ id: lead?.id, field: "id", message: "ID must be a positive numeric value for persistence." });
  }

  const textFields = [
    "name",
    "company",
    "role",
    "department",
    "email",
    "phone",
    "linkedin",
    "location",
    "status",
    "priority",
    "channel",
    "nextAction",
    "owner",
    "source",
    "notes",
    "accountBrand",
    "accountSummary",
    "accountSector",
    "accountCity",
    "accountState",
    "accountCityState",
    "accountSize",
    "accountRevenue",
    "accountWebsite",
    "accountPhone",
    "accountCnpj",
  ];

  const normalized = { ...lead, id: idNum };
  textFields.forEach((field) => {
    const raw = lead?.[field];
    if (isObjectValue(raw)) {
      errors.push({ id: lead?.id, field, message: "Text field cannot be object/array." });
    }
    normalized[field] = normalizeTextForPersistence(field, raw);
  });

  const statusRaw = normalized.status;
  const priorityRaw = normalized.priority;
  if (!isValidEnumValue("status", statusRaw)) {
    errors.push({ id: lead?.id, field: "status", message: "Status is invalid for persistence." });
  }
  if (!isValidEnumValue("priority", priorityRaw)) {
    errors.push({ id: lead?.id, field: "priority", message: "Priority is invalid for persistence." });
  }
  normalized.status = normalizeStatusValue(statusRaw, "New");
  normalized.priority = normalizePriorityValue(priorityRaw, "Medium");
  normalized.channel = formatChannelLabel(normalized.channel);

  const createdIso = formatIsoDate(lead?.createdDate);
  if (!createdIso) {
    errors.push({ id: lead?.id, field: "createdDate", message: "Created Date must be valid (YYYY-MM-DD)." });
  }
  normalized.createdDate = createdIso;

  const nextActionRaw = text(lead?.nextActionDate).trim();
  if (nextActionRaw) {
    const nextIso = formatIsoDate(nextActionRaw);
    if (!nextIso) {
      errors.push({ id: lead?.id, field: "nextActionDate", message: "Next Action Date must be valid (YYYY-MM-DD)." });
      normalized.nextActionDate = "";
    } else {
      normalized.nextActionDate = nextIso;
    }
  } else {
    normalized.nextActionDate = "";
  }

  return normalized;
}

function prepareLeadsForPersistence(data = leads) {
  const errors = [];
  const rows = [];
  const idSet = new Set();

  (data || []).forEach((lead) => {
    if (!lead || typeof lead !== "object" || Array.isArray(lead)) {
      errors.push({ id: "", field: "row", message: "Invalid lead record type (must be object)." });
      return;
    }

    const normalized = normalizeLeadForPersistence(lead, errors);
    if (Number.isFinite(normalized.id)) {
      if (idSet.has(normalized.id)) {
        errors.push({ id: normalized.id, field: "id", message: "Duplicate ID detected before persistence." });
      }
      idSet.add(normalized.id);
    }
    rows.push(normalized);
  });

  return { rows, errors };
}

function validateCriticalFields(data = leads) {
  const errors = [];
  const idSet = new Set();
  (data || []).forEach((lead) => {
    const idNum = Number(lead.id);
    if (!Number.isFinite(idNum) || idNum <= 0) {
      errors.push({ id: lead.id, field: "id", message: "ID must be a positive number." });
    } else {
      if (idSet.has(idNum)) errors.push({ id: idNum, field: "id", message: "Duplicate ID detected." });
      idSet.add(idNum);
    }
    if (!text(lead.company).trim()) errors.push({ id: lead.id, field: "company", message: "Company is required." });
    if (!text(lead.name).trim()) errors.push({ id: lead.id, field: "name", message: "Name is required." });
    if (!isValidEnumValue("status", lead.status)) errors.push({ id: lead.id, field: "status", message: "Status is invalid." });
    if (!isValidEnumValue("priority", lead.priority)) errors.push({ id: lead.id, field: "priority", message: "Priority is invalid." });
    if (!isValidDateText(lead.createdDate)) errors.push({ id: lead.id, field: "createdDate", message: "Created Date is required and must be valid." });
    if (text(lead.nextActionDate).trim() && !isValidDateText(lead.nextActionDate)) {
      errors.push({ id: lead.id, field: "nextActionDate", message: "Next Action Date is invalid." });
    }
  });
  return errors;
}

function runIntegrityCheck(options = {}) {
  const errors = validateCriticalFields(leads);
  const warnings = [];
  const report = { ok: errors.length === 0, errors, warnings };
  if (options.silent) return report;

  if (report.ok) {
    setMsg("Integrity check passed.", "#1e8449");
  } else {
    const preview = errors
      .slice(0, 6)
      .map((e) => `ID ${e.id || "-"} | ${e.field}: ${e.message}`)
      .join(" ; ");
    setMsg(`Integrity check failed (${errors.length} issues). ${preview}`, "#b71c1c");
  }
  return report;
}

async function saveToExcel(file) {
  try {
    const integrity = runIntegrityCheck({ silent: true });
    if (!integrity.ok) {
      setMsg(`Fix critical fields before export (${integrity.errors.length} issues).`, "#b71c1c");
      return;
    }
    const persistence = prepareLeadsForPersistence(leads);
    if (persistence.errors.length) {
      const preview = persistence.errors
        .slice(0, 5)
        .map((e) => `ID ${e.id || "-"} | ${e.field}: ${e.message}`)
        .join(" ; ");
      setMsg(`Fix data types before export (${persistence.errors.length} issues). ${preview}`, "#b71c1c");
      return;
    }
    if (!window.XlsxPopulate) {
      setMsg("Spreadsheet library unavailable.", "#b71c1c");
      return;
    }
    setMsg("Processing file...", "#1f6d41");
    const arrayBuffer = await file.arrayBuffer();
    const wb = await XlsxPopulate.fromDataAsync(arrayBuffer);
    const leadMap = new Map(persistence.rows.map((l) => [Number(l.id), l]));

    let updated = 0;
    const leads = wb.sheet("Leads") || wb.sheet("Leads_Operations") || wb.sheet("Leads_Operacao");
    if (leads) updated += updateById(leads, 1, leadMap, { appendMissing: true });

    wb.sheets().forEach((sheet) => {
      const name = sheet.name();
      if (name && (name.includes("Contacts") || name.includes("Contatos"))) {
        updated += updateById(sheet, 3, leadMap, { appendMissing: false });
      }
    });

    const out = await wb.outputAsync();
    if (window.showSaveFilePicker) {
      const handle = await window.showSaveFilePicker({
        suggestedName: file.name,
        types: [
          {
            description: "Excel Workbook",
            accept: { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"] },
          },
        ],
      });
      const writable = await handle.createWritable();
      await writable.write(out);
      await writable.close();
    } else {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(out);
      a.download = file.name.replace(/\.xlsx$/i, "") + "_updated.xlsx";
      a.click();
    }
    setMsg(`Synced successfully (${updated} rows updated).`, "#1e8449");
    appendAudit("excel_export", { message: `Manual Excel export finished (${updated} rows).` });
  } catch (e) {
    console.error(e);
    setMsg("Failed to save to Excel. Please try again.", "#b71c1c");
  }
}

async function ensureDbFileHandle() {
  if (dbFileHandle) return dbFileHandle;
  if (!window.showOpenFilePicker) return null;
  const handles = await window.showOpenFilePicker({
    multiple: false,
    types: [
      {
        description: "Excel Workbook",
        accept: { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"] },
      },
    ],
  });
  dbFileHandle = handles && handles[0] ? handles[0] : null;
  return dbFileHandle;
}

function isRecoverableDbHandleError(error) {
  const name = text(error?.name).trim();
  const message = norm(error?.message);
  if (name === "NotFoundError" || name === "SecurityError") return true;
  if (name === "NotAllowedError" && message.includes("permission")) return true;
  if (message.includes("not found") || message.includes("no such file")) return true;
  return false;
}

function formatDbSyncError(error) {
  const name = text(error?.name).trim();
  const message = text(error?.message).trim();
  const full = `${name} ${message}`.trim().toLowerCase();
  if (!name && !message) return "unknown error";
  if (name === "AbortError") return "operation cancelled";
  if (name === "NotAllowedError" || full.includes("permission")) return "permission denied by browser";
  if (name === "NotFoundError" || full.includes("not found")) return "selected DB file not found (moved/renamed)";
  if (full.includes("locked") || full.includes("in use") || full.includes("being used")) return "DB file is open/locked by another app";
  return (message || name).slice(0, 120);
}

function isExcelOpenLockError(error) {
  const msg = `${text(error?.name)} ${text(error?.message)}`.toLowerCase();
  return msg.includes("locked") || msg.includes("in use") || msg.includes("being used");
}

function isLockError(error) {
  const msg = `${text(error?.name)} ${text(error?.message)}`.toLowerCase();
  return isExcelOpenLockError(error) || msg.includes("permission");
}

function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function syncChangesToDb() {
  const integrity = runIntegrityCheck({ silent: true });
  if (!integrity.ok) {
    setMsg(`Fix critical fields before DB sync (${integrity.errors.length} issues).`, "#b71c1c");
    return false;
  }
  const persistence = prepareLeadsForPersistence(leads);
  if (persistence.errors.length) {
    const preview = persistence.errors
      .slice(0, 5)
      .map((e) => `ID ${e.id || "-"} | ${e.field}: ${e.message}`)
      .join(" ; ");
    setMsg(`Fix data types before DB sync (${persistence.errors.length} issues). ${preview}`, "#b71c1c");
    return false;
  }
  if (!window.XlsxPopulate || !window.showOpenFilePicker) {
    setMsg("DB sync requires a Chromium browser with file access support.", "#b36b00");
    return false;
  }

  const leadMap = new Map(persistence.rows.map((l) => [Number(l.id), l]));
  let lastError = null;

  const maxAttempts = DB_SYNC_RETRY_DELAYS_MS.length + 1;
  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
    try {
      const handle = await ensureDbFileHandle();
      if (!handle) {
        setMsg("DB file selection cancelled. Changes remain pending.", "#b36b00");
        return false;
      }

      const file = await handle.getFile();
      const arrayBuffer = await file.arrayBuffer();
      const wb = await XlsxPopulate.fromDataAsync(arrayBuffer);

      let updated = 0;
      const leads = wb.sheet("Leads") || wb.sheet("Leads_Operations") || wb.sheet("Leads_Operacao");
      if (leads) updated += updateById(leads, 1, leadMap, { appendMissing: true });

      wb.sheets().forEach((sheet) => {
        const name = sheet.name();
        if (name && (name.includes("Contacts") || name.includes("Contatos"))) {
          updated += updateById(sheet, 3, leadMap, { appendMissing: false });
        }
      });

      const out = await wb.outputAsync();
      const writable = await handle.createWritable();
      await writable.write(out);
      await writable.close();
      dbDirty = false;
      appendAudit("db_sync", { message: `DB updated successfully (${updated} rows).` });
      setMsg(`DB updated successfully (${updated} rows).`, "#1e8449");
      return true;
    } catch (e) {
      lastError = e;
      console.error(e);
      const retryDelay = DB_SYNC_RETRY_DELAYS_MS[attempt - 1];
      if (isExcelOpenLockError(e) && Number.isFinite(retryDelay)) {
        setMsg(
          `DB file is open in Excel (attempt ${attempt}/${maxAttempts}). Close Excel and retrying in ${Math.round(
            retryDelay / 1000
          )}s...`,
          "#b36b00"
        );
        await delay(retryDelay);
        continue;
      }
      if (attempt === 1 && dbFileHandle && isRecoverableDbHandleError(e)) {
        dbFileHandle = null;
        setMsg("DB file handle expired. Please select the DB file again...", "#b36b00");
        continue;
      }
      break;
    }
  }

  if (isExcelOpenLockError(lastError)) {
    setMsg("DB sync failed because the file is open in Excel. Close Excel and try again.", "#b71c1c");
    return false;
  }
  setMsg(`Failed to update DB file (${formatDbSyncError(lastError)}). Changes are still pending.`, "#b71c1c");
  return false;
}

async function saveModalChanges() {
  if (!modalState.type || modalSaveInProgress) return;
  modalSaveInProgress = true;
  updateModalButtons();
  try {
    const confirmSave = confirm("Confirm save these changes?");
    if (!confirmSave) return;

    const values = collectModalValues();
    const editedFields = Object.keys(values);
    if (modalState.type === "contact") {
      applyContactModalChanges(values);
      appendAudit("modal_edit", {
        leadIds: text(modalState.contactId),
        field: editedFields.join("|"),
        message: `Contact modal edit (${editedFields.length} fields).`,
      });
    } else if (modalState.type === "company") {
      const impacted = getCompanyLeads(modalState.companyName).map((lead) => lead.id).join(",");
      applyCompanyModalChanges(values);
      appendAudit("modal_edit", {
        leadIds: impacted,
        field: editedFields.join("|"),
        message: `Company modal edit (${editedFields.length} fields).`,
      });
    }

    persist();
    markDbDirty();
    modalState.editing = false;
    refresh();
    renderActiveModal();

    const confirmSync = confirm("Sync these changes to DB now?");
    if (!confirmSync) {
      setMsg("Changes saved in dashboard. DB sync pending.", "#b36b00");
      return;
    }
    await syncChangesToDb();
  } finally {
    modalSaveInProgress = false;
    updateModalButtons();
  }
}

