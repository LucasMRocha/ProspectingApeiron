function daysUntilDate(dateValue) {
  const dt = normalizeDate(dateValue);
  if (!dt) return Number.POSITIVE_INFINITY;
  const now = new Date();
  now.setHours(0, 0, 0, 0);
  return Math.round((dt.getTime() - now.getTime()) / 86400000);
}

function rankingLabel(score) {
  if (score >= 70) return "Critical";
  if (score >= 40) return "High";
  return "Normal";
}

function isOpenLead(lead) {
  const status = text(lead.status).trim();
  return status !== "Client" && status !== "Discarded";
}

function urgencyPointsByDate(dateValue) {
  const dueDays = daysUntilDate(dateValue);
  if (!Number.isFinite(dueDays)) return 0;
  if (dueDays < 0) return 30;
  if (dueDays <= 3) return 20;
  return 0;
}

function contactPriorityPoints(priorityValue) {
  const priority = text(priorityValue).trim();
  if (priority === "High") return 40;
  if (priority === "Medium") return 20;
  if (priority === "Low") return 10;
  return 0;
}

function clampRankingScore(scoreValue) {
  return Math.max(0, Math.min(99, Number(scoreValue) || 0));
}

const APEIRON_SECTOR_KEYWORDS = /oil|gas|o&g|petr[oó]leo|petroqui?m|energy|energia|mining|minera[cç][aã]o|siderur|chemicals?|qui?mi|offshore|fpso|epc|refin/i;
const APEIRON_ROLE_KEYWORDS = /instrument|automa[tcç]|el[eé]tric|electr|maintenance|manuten[cç]|icss|scada|plc|clp|dcs|safety|seguran[cç]a|cybersec|ciberseg|hmi|control|engenheiro|engineer/i;

function apeironSectorFit(sectorOrSummary) {
  const val = text(sectorOrSummary);
  return val && APEIRON_SECTOR_KEYWORDS.test(val) ? 1 : 0;
}

function apeironRoleFit(role) {
  const val = text(role);
  return val && APEIRON_ROLE_KEYWORDS.test(val) ? 1 : 0;
}

function scoreCompanyGroup(groupLeads) {
  const openLeadPoints = Math.min(25, (groupLeads?.length || 0) * 5);
  const hasHighPriority = (groupLeads || []).some((lead) => text(lead.priority).trim() === "High");
  const nextDate = earliestDateText((groupLeads || []).map((lead) => lead.nextActionDate));
  const urgency = urgencyPointsByDate(nextDate);
  const highPriorityPoints = hasHighPriority ? 20 : 0;
  let sectorFit = 0;
  let roleFit = 0;
  for (const lead of (groupLeads || [])) {
    if (!sectorFit && apeironSectorFit(lead.accountSector || lead.accountSummary)) sectorFit = 15;
    if (!roleFit && apeironRoleFit(lead.role)) roleFit = 10;
    if (sectorFit && roleFit) break;
  }
  return clampRankingScore(openLeadPoints + highPriorityPoints + urgency + sectorFit + roleFit);
}

function scoreContactLead(lead) {
  const base = contactPriorityPoints(lead?.priority);
  const urgency = urgencyPointsByDate(lead?.nextActionDate);
  let bonus = 0;
  if (text(lead?.email)) bonus += 3;
  if (text(lead?.linkedin)) bonus += 3;
  if (text(lead?.nextAction)) bonus += 2;
  if (text(lead?.phone)) bonus += 2;
  const tier = text(lead?.tier).toUpperCase();
  if (tier === "T1") bonus += 6;
  else if (tier === "T2") bonus += 3;
  else if (tier === "T3") bonus += 1;
  const ls = Number(lead?.leadScore) || 0;
  if (ls > 0) bonus += Math.min(8, Math.round(ls / 12));
  if (apeironRoleFit(lead?.role)) bonus += 10;
  if (apeironSectorFit(lead?.accountSector || lead?.accountSummary)) bonus += 8;
  return clampRankingScore(base + urgency + bonus);
}

function contactScoreBriefing(lead) {
  const parts = [];
  const p = text(lead?.priority).trim();
  if (p === "High") parts.push("Priority High (+40)");
  else if (p === "Medium") parts.push("Priority Medium (+20)");
  else if (p === "Low") parts.push("Priority Low (+10)");
  const dueDays = daysUntilDate(lead?.nextActionDate);
  if (Number.isFinite(dueDays)) {
    if (dueDays < 0) parts.push("Overdue (+30)");
    else if (dueDays <= 3) parts.push("Due soon (+20)");
  }
  if (apeironRoleFit(lead?.role)) parts.push("Role fit (+10)");
  if (apeironSectorFit(lead?.accountSector || lead?.accountSummary)) parts.push("Sector fit (+8)");
  const tier = text(lead?.tier).toUpperCase();
  if (tier === "T1") parts.push("Tier T1 (+6)");
  else if (tier === "T2") parts.push("Tier T2 (+3)");
  else if (tier === "T3") parts.push("Tier T3 (+1)");
  if (text(lead?.email)) parts.push("Email (+3)");
  if (text(lead?.linkedin)) parts.push("LinkedIn (+3)");
  if (text(lead?.nextAction)) parts.push("Next action (+2)");
  if (text(lead?.phone)) parts.push("Phone (+2)");
  const ls = Number(lead?.leadScore) || 0;
  if (ls > 0) parts.push(`Lead Score ${ls} (+${Math.min(8, Math.round(ls / 12))})`);
  return parts.join(" · ") || "No scoring factors";
}

