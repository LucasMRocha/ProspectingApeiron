}

function refresh() {
  const data = filtered();
  renderKPIs(data);
  renderCompanyRanking(data);
  renderContactRanking(data);
  updateOperationalHeaders();
  const tableData = operationalMode === "companies" ? buildCompanyRows(data) : data;
  const sortedRows = applySort(tableData);
  const pageMeta = paginateRows(sortedRows);
  renderTable(pageMeta.rows);
  applyColumnOrder();
  applyColumnVisibility();
  applyColumnWidths();
  applyFrozenColumns();
  renderColumnsMenu();
  renderPagination(pageMeta);
