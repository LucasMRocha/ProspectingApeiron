    scrollWrap.addEventListener("scroll", () => { if (!syncing) { syncing = true; stickyScroll.scrollLeft = scrollWrap.scrollLeft; syncing = false; } });
  }

  window.addEventListener("beforeunload", (event) => {
    if (!dbDirty) return;
    event.preventDefault();
