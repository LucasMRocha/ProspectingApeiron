}

function todayIso() {
  return new Date().toISOString().slice(0, 10);
}

function safeUrl(v) {
  const value = text(v).trim();
  if (!value) return "";
  if (/^https?:\/\//i.test(value)) return value;
  return `https://${value}`;
}

function inferDetailLinkType(label, raw, explicitType = "") {
  const type = norm(explicitType);
  if (type === "email" || type === "phone" || type === "url") return type;

  const l = norm(label);
  if (l.includes("linkedin") || l.includes("website") || l.includes("site") || l.includes("url")) return "url";
  if (l.includes("email")) return "email";
  if (l.includes("phone") || l.includes("telefone") || l.includes("whatsapp")) return "phone";

  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw)) return "email";
  if (/^https?:\/\//i.test(raw) || /^www\./i.test(raw) || /linkedin\.com/i.test(raw)) return "url";

  const digits = raw.replace(/\D/g, "");
  if (digits.length >= 8 && /[\d+]/.test(raw)) return "phone";
  return "";
}

function detailField(label, value, options = {}) {
  const raw = text(value).trim();
  const isFull = options.full ? " full" : "";
  let rendered = raw ? escHtml(raw) : "Not available";
  const resolvedType = options.type === "textarea" ? "" : inferDetailLinkType(label, raw, options.type);
  if (raw && resolvedType === "email") rendered = `<a href="mailto:${escAttr(raw)}">${escHtml(raw)}</a>`;
  if (raw && resolvedType === "phone") rendered = `<a href="tel:${escAttr(raw)}">${escHtml(raw)}</a>`;
  if (raw && resolvedType === "url") {
    const href = safeUrl(raw);
    rendered = `<a href="${escAttr(href)}" target="_blank" rel="noopener noreferrer">${escHtml(raw)}</a>`;
  }
  return `<div class="contact-field${isFull}"><div class="k">${escHtml(label)}</div><div class="v">${rendered}</div></div>`;
}

