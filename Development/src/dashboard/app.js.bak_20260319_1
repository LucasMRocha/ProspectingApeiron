function text(v) {
  return String(v ?? "");
}

function norm(v) {
  return text(v).trim().toLowerCase();
}

function isValidEnumValue(enumKey, value) {
  const options = VALID_ENUMS[enumKey] || [];
  return options.includes(text(value).trim());
}

function normalizeEnumValue(enumKey, value, fallbackValue = "") {
  const candidate = text(value).trim();
  if (isValidEnumValue(enumKey, candidate)) return candidate;
  return text(fallbackValue).trim();
}

function normalizeStatusValue(value, fallbackValue = "New") {
  return normalizeEnumValue("status", value, fallbackValue);
}

function normalizePriorityValue(value, fallbackValue = "Medium") {
  return normalizeEnumValue("priority", value, fallbackValue);
}

function stripHtmlTags(rawValue) {
  let out = text(rawValue);
  out = out.replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, " ");
  out = out.replace(/<style[\s\S]*?>[\s\S]*?<\/style>/gi, " ");
  out = out.replace(/<!--[\s\S]*?-->/g, " ");
  out = out.replace(/<\/?[^>]+>/g, " ");
  return out;
}

function sanitizeUserInput(rawValue, options = {}) {
  const multiline = options.multiline === true;
  let out = stripHtmlTags(rawValue);
  out = out.replace(/\u0000/g, "");
  out = out.replace(/[\u0001-\u0008\u000B\u000C\u000E-\u001F\u007F]/g, " ");
  out = out.replace(/[<>]/g, " ");
  if (multiline) {
    out = out.replace(/\r\n?/g, "\n").replace(/\t/g, " ");
    out = out.replace(/[ \f\v]+\n/g, "\n").replace(/\n[ \f\v]+/g, "\n");
    out = out.replace(/\n{3,}/g, "\n\n");
  } else {
    out = out.replace(/[\r\n\t]+/g, " ");
  }
  out = out.replace(/\s{2,}/g, " ");
  return out.trim();
}

function sanitizeModalInputValue(key, rawValue, options = {}) {
  let out = sanitizeUserInput(rawValue, options);
  const field = norm(key);
  if (field.includes("email")) out = out.replace(/["'`<>]/g, "");
  if (field.includes("linkedin") || field.includes("website")) out = out.replace(/[\s"'`<>]/g, "");
  if (field.includes("phone")) out = out.replace(/[^\d+()\-\s./]/g, "");
  return out.trim();
}

function perfNow() {
