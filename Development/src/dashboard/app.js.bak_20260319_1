function getColumnWidthsForMode(mode) {
  const key = mode === "companies" ? "companies" : "contacts";
  const src = columnWidthByMode[key] || {};
  const out = {};
  TABLE_COLUMN_KEYS.forEach((key) => {
    const width = Number(src[key]);
    if (Number.isFinite(width) && width >= MIN_COLUMN_WIDTH) {
      out[key] = Math.round(width);
    }
  });
  return out;
}

function setActiveColumnWidth(key, widthPx) {
  if (!TABLE_COLUMN_KEYS.includes(key)) return;
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  if (!columnWidthByMode[mode]) columnWidthByMode[mode] = {};
  const width = Math.round(Number(widthPx) || 0);
  if (!Number.isFinite(width) || width < MIN_COLUMN_WIDTH) {
    delete columnWidthByMode[mode][key];
    return;
  }
  columnWidthByMode[mode][key] = width;
}

function sanitizeHiddenColumns(rawColumns) {
  const incoming = Array.isArray(rawColumns) ? rawColumns.map((x) => text(x).trim()) : [];
  const used = new Set();
  const out = [];
  incoming.forEach((key) => {
    if (!TABLE_COLUMN_KEYS.includes(key) || used.has(key)) return;
    used.add(key);
