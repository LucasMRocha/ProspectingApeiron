const STORAGE_KEY = "apeiron_ops_hub_en_v1";
const DATA_VERSION_KEY = "apeiron_ops_hub_data_version_v1";
const VIEW_KEY = "apeiron_ops_hub_view_v6";
const AI_PROVIDER_STORAGE = "apeiron_ops_hub_ai_provider_v1";
const AI_KEY_OPENAI_STORAGE = "apeiron_ops_hub_openai_key_v1";
const AI_KEY_GEMINI_STORAGE = "apeiron_ops_hub_gemini_key_v1";
const AI_OPENAI_MODEL = "gpt-4o-mini";
const AI_GEMINI_MODEL = "gemini-1.5-flash";
const INITIAL_DATA = window.INITIAL_DATA || [];
const INITIAL_DATA_VERSION = text(window.INITIAL_DATA_VERSION || "");
const STATUS = ["New", "In Contact", "Meeting Scheduled", "Proposal Sent", "Client", "Discarded"];
const KANBAN_STATUS = STATUS.filter((status) => !["Proposal Sent", "Client", "Discarded"].includes(status));
const PRIORITY = ["High", "Medium", "Low"];
const CHANNEL_METHODS = ["Email", "Phone", "LinkedIn", "WhatsApp"];
const DATA_QUALITY_FILTER_OPTIONS = [
  { value: "missing_contact", label: "Data quality: missing contact info" },
  { value: "missing_cnpj", label: "Data quality: missing CNPJ" },
  { value: "missing_company_core", label: "Data quality: missing company core fields" },
  { value: "contact_ready", label: "Data quality: contact-ready records" },
];
const TABLE_COLUMN_KEYS = ["id", "company", "cityState", "name", "role", "status", "priority", "createdDate", "nextAction", "date", "channel", "leadInsight"];
const TABLE_SORT_KEYS = [...TABLE_COLUMN_KEYS];
const DEFAULT_FROZEN_KEYS_BY_MODE = {
  contacts: ["id", "name", "company"],
  companies: ["id", "name", "cityState"],
};
const MIN_COLUMN_WIDTH = 88;
const DEFAULT_COLUMN_ORDER_BY_MODE = {
  contacts: ["id", "name", "company", "cityState", "role", "status", "priority", "createdDate", "nextAction", "date", "channel", "leadInsight"],
  companies: ["id", "name", "cityState", "company", "role", "status", "priority", "createdDate", "nextAction", "date", "channel", "leadInsight"],
};
const COLUMN_FILTER_IDS = [
  "cfId",
  "cfCompany",
  "cfCityState",
  "cfName",
  "cfRole",
  "cfStatus",
  "cfPriority",
  "cfCreatedDate",
  "cfNextAction",
  "cfDate",
  "cfChannel",
  "cfLeadInsight",
];
const VIEW_FILTER_IDS = ["q", "fStatus", "fPrio", "fChannel", "fDataQuality", ...COLUMN_FILTER_IDS];

let onlyOverdue = false;
let operationalMode = "contacts";
let currentPage = 1;
let pageSize = 25;
let sortKey = "";
let sortDir = 0;
let dragColumnKey = "";
let dragHappened = false;
let suppressHeaderClick = false;
let columnOrderByMode = {
  contacts: [...DEFAULT_COLUMN_ORDER_BY_MODE.contacts],
  companies: [...DEFAULT_COLUMN_ORDER_BY_MODE.companies],
};
let columnWidthByMode = {
  contacts: {},
  companies: {},
};
let hiddenColumnsByMode = {
  contacts: [],
  companies: [],
};
let dbDirty = false;
let dbFileHandle = null;
let modalState = { type: "", contactId: null, companyName: "", editing: false };
let ocrImageFile = null;
let ocrBusy = false;
let restoredViewFilters = null;
let leads = normalizeLeadChannels(normalizeLeadsSchema(loadData()));

function text(v) {
  return String(v ?? "");
}

function norm(v) {
  return text(v).trim().toLowerCase();
}

function perfNow() {
  if (typeof performance !== "undefined" && typeof performance.now === "function") return performance.now();
  return Date.now();
}

function fmtMs(ms) {
  const value = Number(ms);
  if (!Number.isFinite(value)) return "";
  return `${Math.max(0, Math.round(value))}ms`;
}

function logPerf(label, payload) {
  try {
    console.log(`[PERF] ${label}`, payload);
  } catch (_) {}
}

function escHtml(v) {
  return text(v).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

function escAttr(v) {
  return escHtml(v).replaceAll('"', "&quot;");
}

function canonicalChannelToken(token) {
  const t = norm(token);
  if (!t) return "";
  if (t.includes("no contact") || t.includes("sem contato")) return "NO_CONTACT";
  if (t.includes("telefone") || t.includes("phone")) return "Phone";
  if (t.includes("email") || t.includes("e-mail")) return "Email";
  if (t.includes("linkedin")) return "LinkedIn";
  if (t.includes("whatsapp") || t.includes("whats")) return "WhatsApp";
  return "";
}

function parseChannelSet(rawValue) {
  const raw = text(rawValue).trim();
  if (!raw) return new Set();

  const normalized = raw
    .replace(/\s*(\+|,|;|\/|\|)\s*/g, ",")
    .replace(/\s+e\s+/gi, ",")
    .replace(/\s+and\s+/gi, ",");
  const tokens = normalized.split(",").map((x) => x.trim()).filter(Boolean);
  if (!tokens.length) return new Set();

  const out = new Set();
  for (const tk of tokens) {
    const canonical = canonicalChannelToken(tk);
    if (!canonical) continue;
    if (canonical === "NO_CONTACT") {
      out.clear();
      return out;
    }
    out.add(canonical);
  }
  return out;
}

function channelSetToStorage(setLike) {
  const set = new Set(setLike || []);
  const ordered = CHANNEL_METHODS.filter((m) => set.has(m));
  return ordered.length ? ordered.join(", ") : "No contact";
}

function formatChannelLabel(rawValue) {
  return channelSetToStorage(parseChannelSet(rawValue));
}

function leadMatchesChannel(lead, selectedChannel) {
  const desired = canonicalChannelToken(selectedChannel);
  const current = parseChannelSet(lead.channel);
  if (!desired || desired === "NO_CONTACT") return current.size === 0;
  return current.has(desired);
}

function hasDirectContactInfo(lead) {
  const channels = parseChannelSet(lead.channel);
  if (channels.size > 0) return true;
  return Boolean(text(lead.email).trim() || text(lead.phone).trim() || text(lead.linkedin).trim());
}

function hasCompanyCoreFields(lead) {
  return Boolean(text(lead.accountWebsite).trim() && text(lead.accountCityState).trim() && text(lead.accountSector).trim());
}

function hasCompanyCnpj(lead) {
  return Boolean(text(lead.accountCnpj).trim());
}

function matchesDataQualityFilter(lead, filterValue) {
  const key = norm(filterValue);
  if (!key) return true;
  if (key === "missing_contact") return !hasDirectContactInfo(lead);
  if (key === "missing_cnpj") return !hasCompanyCnpj(lead);
  if (key === "missing_company_core") return !hasCompanyCoreFields(lead);
  if (key === "contact_ready") return hasDirectContactInfo(lead) && hasCompanyCoreFields(lead);
  return true;
}

function normalizeLeadChannels(data) {
  return (data || []).map((lead) => ({ ...lead, channel: formatChannelLabel(lead.channel) }));
}

function normalizeLeadsSchema(data) {
  return (data || []).map((lead) => ({
    ...lead,
    accountBrand: text(lead.accountBrand || lead.accountMarca || "").trim(),
    createdDate: text(lead.createdDate || lead.creationDate || lead.createdAt || "").trim(),
  }));
}

function todayIso() {
  return new Date().toISOString().slice(0, 10);
}

function safeUrl(v) {
  const value = text(v).trim();
  if (!value) return "";
  if (/^https?:\/\//i.test(value)) return value;
  return `https://${value}`;
}

function inferDetailLinkType(label, raw, explicitType = "") {
  const type = norm(explicitType);
  if (type === "email" || type === "phone" || type === "url") return type;

  const l = norm(label);
  if (l.includes("linkedin") || l.includes("website") || l.includes("site") || l.includes("url")) return "url";
  if (l.includes("email")) return "email";
  if (l.includes("phone") || l.includes("telefone") || l.includes("whatsapp")) return "phone";

  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(raw)) return "email";
  if (/^https?:\/\//i.test(raw) || /^www\./i.test(raw) || /linkedin\.com/i.test(raw)) return "url";

  const digits = raw.replace(/\D/g, "");
  if (digits.length >= 8 && /[\d+]/.test(raw)) return "phone";
  return "";
}

function detailField(label, value, options = {}) {
  const raw = text(value).trim();
  const isFull = options.full ? " full" : "";
  let rendered = raw ? escHtml(raw) : "Not available";
  const resolvedType = options.type === "textarea" ? "" : inferDetailLinkType(label, raw, options.type);
  if (raw && resolvedType === "email") rendered = `<a href="mailto:${escAttr(raw)}">${escHtml(raw)}</a>`;
  if (raw && resolvedType === "phone") rendered = `<a href="tel:${escAttr(raw)}">${escHtml(raw)}</a>`;
  if (raw && resolvedType === "url") {
    const href = safeUrl(raw);
    rendered = `<a href="${escAttr(href)}" target="_blank" rel="noopener noreferrer">${escHtml(raw)}</a>`;
  }
  return `<div class="contact-field${isFull}"><div class="k">${escHtml(label)}</div><div class="v">${rendered}</div></div>`;
}

function getLeadById(id) {
  return leads.find((l) => Number(l.id) === Number(id)) || null;
}

function firstNonEmpty(leadsList, key) {
  for (const item of leadsList) {
    const value = text(item[key]).trim();
    if (value) return value;
  }
  return "";
}

function cityStateFromLead(lead) {
  const city = text(lead.accountCity).trim();
  const state = text(lead.accountState).trim();
  if (city && state) return `${city}/${state}`;
  if (city || state) return city || state;
  return text(lead.accountCityState || lead.location).trim();
}

function splitCityState(rawValue) {
  const raw = text(rawValue).trim();
  if (!raw) return { city: "", state: "" };
  if (raw.includes("/")) {
    const [city, state] = raw.split("/");
    return { city: text(city).trim(), state: text(state).trim() };
  }
  if (raw.includes(",")) {
    const [city, state] = raw.split(",");
    return { city: text(city).trim(), state: text(state).trim() };
  }
  return { city: raw, state: "" };
}

function composeCityState(city, state) {
  const c = text(city).trim();
  const s = text(state).trim();
  if (c && s) return `${c}/${s}`;
  return c || s;
}

function normalizePhoneDigits(value) {
  return text(value).replace(/\D/g, "");
}

function pickFirst(arr) {
  if (!Array.isArray(arr)) return "";
  for (const v of arr) {
    const t = text(v).trim();
    if (t) return t;
  }
  return "";
}

function uniqValues(arr) {
  const seen = new Set();
  const out = [];
  (arr || []).forEach((item) => {
    const v = text(item).trim();
    const key = norm(v);
    if (!v || seen.has(key)) return;
    seen.add(key);
    out.push(v);
  });
  return out;
}

function channelSetFromContactFields(fields) {
  const channels = new Set();
  if (text(fields.email).trim()) channels.add("Email");
  if (text(fields.phone).trim()) channels.add("Phone");
  if (text(fields.linkedin).trim()) channels.add("LinkedIn");
  return channels;
}

function toTitleCase(value) {
  const raw = text(value).trim();
  if (!raw) return "";
  return raw
    .toLowerCase()
    .split(/\s+/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function nextLeadId() {
  const maxId = leads.reduce((acc, item) => {
    const id = Number(item.id);
    return Number.isFinite(id) ? Math.max(acc, id) : acc;
  }, 0);
  return maxId + 1;
}

function sanitizeColumnOrder(rawOrder) {
  const incoming = Array.isArray(rawOrder) ? rawOrder.map((x) => text(x).trim()) : [];
  const used = new Set();
  const out = [];
  incoming.forEach((key) => {
    if (!TABLE_COLUMN_KEYS.includes(key) || used.has(key)) return;
    used.add(key);
    out.push(key);
  });
  TABLE_COLUMN_KEYS.forEach((key) => {
    if (used.has(key)) return;
    out.push(key);
  });
  return out;
}

function getActiveColumnOrder() {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  return sanitizeColumnOrder(columnOrderByMode[mode] || DEFAULT_COLUMN_ORDER_BY_MODE[mode]);
}

function setActiveColumnOrder(order) {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  columnOrderByMode[mode] = sanitizeColumnOrder(order);
}

function getActiveColumnWidths() {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  return getColumnWidthsForMode(mode);
}

function getColumnWidthsForMode(mode) {
  const key = mode === "companies" ? "companies" : "contacts";
  const src = columnWidthByMode[key] || {};
  const out = {};
  TABLE_COLUMN_KEYS.forEach((key) => {
    const width = Number(src[key]);
    if (Number.isFinite(width) && width >= MIN_COLUMN_WIDTH) {
      out[key] = Math.round(width);
    }
  });
  return out;
}

function setActiveColumnWidth(key, widthPx) {
  if (!TABLE_COLUMN_KEYS.includes(key)) return;
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  if (!columnWidthByMode[mode]) columnWidthByMode[mode] = {};
  const width = Math.round(Number(widthPx) || 0);
  if (!Number.isFinite(width) || width < MIN_COLUMN_WIDTH) {
    delete columnWidthByMode[mode][key];
    return;
  }
  columnWidthByMode[mode][key] = width;
}

function sanitizeHiddenColumns(rawColumns) {
  const incoming = Array.isArray(rawColumns) ? rawColumns.map((x) => text(x).trim()) : [];
  const used = new Set();
  const out = [];
  incoming.forEach((key) => {
    if (!TABLE_COLUMN_KEYS.includes(key) || used.has(key)) return;
    used.add(key);
    out.push(key);
  });
  return out;
}

function getActiveHiddenColumns() {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  return sanitizeHiddenColumns(hiddenColumnsByMode[mode] || []);
}

function setActiveHiddenColumns(columns) {
  const mode = operationalMode === "companies" ? "companies" : "contacts";
  hiddenColumnsByMode[mode] = sanitizeHiddenColumns(columns);
}

function readViewFiltersFromDom() {
  const out = {};
  VIEW_FILTER_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    out[id] = text(el.value);
  });
  return out;
}

function applyViewFiltersToDom(filters) {
  if (!filters || typeof filters !== "object") return;
  VIEW_FILTER_IDS.forEach((id) => {
    if (!Object.prototype.hasOwnProperty.call(filters, id)) return;
    const el = document.getElementById(id);
    if (!el) return;
    el.value = text(filters[id]);
  });
}

function loadViewPreferences() {
  try {
    const raw = localStorage.getItem(VIEW_KEY);
    if (!raw) return;
    const saved = JSON.parse(raw);
    if (!saved || typeof saved !== "object") return;

    if (saved.operationalMode === "contacts" || saved.operationalMode === "companies") {
      operationalMode = saved.operationalMode;
    }
    const savedRows = Number(saved.pageSize);
    if (Number.isFinite(savedRows)) pageSize = savedRows;

    if (saved.columnOrderByMode && typeof saved.columnOrderByMode === "object") {
      if (Array.isArray(saved.columnOrderByMode.contacts)) {
        columnOrderByMode.contacts = sanitizeColumnOrder(saved.columnOrderByMode.contacts);
      }
      if (Array.isArray(saved.columnOrderByMode.companies)) {
        columnOrderByMode.companies = sanitizeColumnOrder(saved.columnOrderByMode.companies);
      }
    }
    if (saved.columnWidthByMode && typeof saved.columnWidthByMode === "object") {
      const normalizeMap = (raw) => {
        const out = {};
        if (!raw || typeof raw !== "object") return out;
        TABLE_COLUMN_KEYS.forEach((key) => {
          const width = Number(raw[key]);
          if (Number.isFinite(width) && width >= MIN_COLUMN_WIDTH) out[key] = Math.round(width);
        });
        return out;
      };
      columnWidthByMode = {
        contacts: normalizeMap(saved.columnWidthByMode.contacts),
        companies: normalizeMap(saved.columnWidthByMode.companies),
      };
    }
    if (saved.hiddenColumnsByMode && typeof saved.hiddenColumnsByMode === "object") {
      hiddenColumnsByMode = {
        contacts: sanitizeHiddenColumns(saved.hiddenColumnsByMode.contacts),
        companies: sanitizeHiddenColumns(saved.hiddenColumnsByMode.companies),
      };
    }

    if (TABLE_SORT_KEYS.includes(saved.sortKey)) {
      sortKey = saved.sortKey;
    }
    if (saved.sortDir === 1 || saved.sortDir === -1) {
      sortDir = saved.sortDir;
    } else {
      sortDir = 0;
    }
    onlyOverdue = saved.onlyOverdue === true;
    if (saved.filters && typeof saved.filters === "object") {
      restoredViewFilters = saved.filters;
    }
  } catch (_) {}
}

function saveViewPreferences(silent = false) {
  const payload = {
    operationalMode,
    pageSize,
    sortKey,
    sortDir,
    onlyOverdue,
    filters: readViewFiltersFromDom(),
    columnOrderByMode: {
      contacts: sanitizeColumnOrder(columnOrderByMode.contacts),
      companies: sanitizeColumnOrder(columnOrderByMode.companies),
    },
    columnWidthByMode: {
      contacts: getColumnWidthsForMode("contacts"),
      companies: getColumnWidthsForMode("companies"),
    },
    hiddenColumnsByMode: {
      contacts: sanitizeHiddenColumns(hiddenColumnsByMode.contacts),
      companies: sanitizeHiddenColumns(hiddenColumnsByMode.companies),
    },
  };
  localStorage.setItem(VIEW_KEY, JSON.stringify(payload));
  if (!silent) setMsg("View saved successfully.", "#1e8449");
}

function getCompanyLeads(companyName) {
  const wanted = norm(companyName);
  return leads.filter((l) => norm(l.company) === wanted);
}

function companyChannelSummary(companyLeads) {
  const counts = { Email: 0, Phone: 0, LinkedIn: 0, WhatsApp: 0 };
  companyLeads.forEach((lead) => {
    const channels = parseChannelSet(lead.channel);
    CHANNEL_METHODS.forEach((method) => {
      if (channels.has(method)) counts[method] += 1;
    });
  });
  return `Email: ${counts.Email} | Phone: ${counts.Phone} | LinkedIn: ${counts.LinkedIn} | WhatsApp: ${counts.WhatsApp}`;
}

function renderModalField(field, editing) {
  const label = text(field.label).trim();
  const key = text(field.key).trim();
  const value = text(field.value);
  const full = field.full ? " full" : "";

  if (!editing || !key || field.readonly) {
    return detailField(label, value, { type: field.type, full: field.full });
  }

  if (field.type === "select") {
    const options = (field.options || [])
      .map((opt) => `<option value="${escAttr(opt)}" ${opt === value ? "selected" : ""}>${escHtml(opt)}</option>`)
      .join("");
    return `<div class="contact-field${full}"><div class="k">${escHtml(label)}</div><select class="modal-input" data-modal-key="${escAttr(key)}">${options}</select></div>`;
  }

  if (field.type === "textarea") {
    return `<div class="contact-field${full}"><div class="k">${escHtml(label)}</div><textarea class="modal-textarea" data-modal-key="${escAttr(key)}">${escHtml(value)}</textarea></div>`;
  }

  return `<div class="contact-field${full}"><div class="k">${escHtml(label)}</div><input class="modal-input" data-modal-key="${escAttr(key)}" value="${escAttr(value)}" /></div>`;
}

function renderContactModalFields(lead, editing) {
  const fields = [
    { label: "Name", key: "name", value: lead.name },
    { label: "Company", key: "company", value: lead.company },
    { label: "Brand", key: "accountBrand", value: lead.accountBrand },
    { label: "Role", key: "role", value: lead.role },
    { label: "Email", key: "email", value: lead.email, type: "email" },
    { label: "Phone", key: "phone", value: lead.phone, type: "phone" },
    { label: "LinkedIn", key: "linkedin", value: lead.linkedin, type: "url" },
    { label: "Location", key: "location", value: lead.location },
    { label: "Department", key: "department", value: lead.department },
    { label: "Status", key: "status", value: lead.status, type: "select", options: STATUS },
    { label: "Priority", key: "priority", value: lead.priority, type: "select", options: PRIORITY },
    { label: "Contact Channel", key: "", value: formatChannelLabel(lead.channel), readonly: true },
    { label: "Next Action", key: "nextAction", value: lead.nextAction, type: "textarea", full: true },
    { label: "Next Action Date", key: "nextActionDate", value: lead.nextActionDate },
    { label: "Lead Insight", key: "owner", value: lead.owner, type: "textarea", full: true },
    { label: "Notes", key: "notes", value: lead.notes, type: "textarea", full: true },
    { label: "Account City", key: "accountCity", value: lead.accountCity },
    { label: "Account State", key: "accountState", value: lead.accountState },
  ];
  return fields.map((field) => renderModalField(field, editing)).join("");
}

function renderCompanyModalFields(companyLeads, editing) {
  const companyName = firstNonEmpty(companyLeads, "company");
  const cityState = splitCityState(firstNonEmpty(companyLeads, "accountCityState"));
  const city = firstNonEmpty(companyLeads, "accountCity") || cityState.city;
  const state = firstNonEmpty(companyLeads, "accountState") || cityState.state;
  const total = companyLeads.length;
  const inContact = companyLeads.filter((l) => l.status === "In Contact").length;
  const meetings = companyLeads.filter((l) => l.status === "Meeting Scheduled").length;
  const highPriority = companyLeads.filter((l) => l.priority === "High").length;

  const fields = [
    { label: "Company", key: "company", value: companyName },
    { label: "Brand", key: "accountBrand", value: firstNonEmpty(companyLeads, "accountBrand") },
    { label: "Total Leads", key: "", value: total, readonly: true },
    { label: "In Contact", key: "", value: inContact, readonly: true },
    { label: "Meetings Scheduled", key: "", value: meetings, readonly: true },
    { label: "High Priority Leads", key: "", value: highPriority, readonly: true },
    { label: "Main Contact Phone", key: "accountPhone", value: firstNonEmpty(companyLeads, "accountPhone") || firstNonEmpty(companyLeads, "phone"), type: "phone" },
    { label: "Website", key: "accountWebsite", value: firstNonEmpty(companyLeads, "accountWebsite"), type: "url" },
    { label: "CNPJ", key: "accountCnpj", value: firstNonEmpty(companyLeads, "accountCnpj") },
    { label: "Sector", key: "accountSector", value: firstNonEmpty(companyLeads, "accountSector") },
    { label: "City", key: "accountCity", value: city },
    { label: "State", key: "accountState", value: state },
    { label: "Company Size", key: "accountSize", value: firstNonEmpty(companyLeads, "accountSize") },
    { label: "Revenue", key: "accountRevenue", value: firstNonEmpty(companyLeads, "accountRevenue") },
    { label: "Channel Coverage", key: "", value: companyChannelSummary(companyLeads), readonly: true, full: true },
    { label: "Account Summary", key: "accountSummary", value: firstNonEmpty(companyLeads, "accountSummary"), type: "textarea", full: true },
  ];
  return fields.map((field) => renderModalField(field, editing)).join("");
}

function updateModalButtons() {
  const btnEdit = document.getElementById("contactModalEdit");
  const btnSave = document.getElementById("contactModalSave");
  const btnCancel = document.getElementById("contactModalCancel");
  if (!btnEdit || !btnSave || !btnCancel) return;
  if (!modalState.type) {
    btnEdit.style.display = "none";
    btnSave.style.display = "none";
    btnCancel.style.display = "none";
    return;
  }
  btnEdit.style.display = modalState.editing ? "none" : "inline-flex";
  btnSave.style.display = modalState.editing ? "inline-flex" : "none";
  btnCancel.style.display = modalState.editing ? "inline-flex" : "none";
}

function renderActiveModal() {
  const modal = document.getElementById("contactModal");
  const title = document.getElementById("contactModalTitle");
  const body = document.getElementById("contactModalBody");
  if (!modal || !title || !body) return;

  if (modalState.type === "contact") {
    const lead = getLeadById(modalState.contactId);
    if (!lead) return;
    title.textContent = `Contact Details - ${lead.name || "Unnamed contact"}`;
    body.innerHTML = renderContactModalFields(lead, modalState.editing);
  } else if (modalState.type === "company") {
    const companyLeads = getCompanyLeads(modalState.companyName);
    if (!companyLeads.length) return;
    title.textContent = `Company Details - ${modalState.companyName}`;
    body.innerHTML = renderCompanyModalFields(companyLeads, modalState.editing);
  } else {
    return;
  }
  updateModalButtons();
  modal.setAttribute("aria-hidden", "false");
}

function openCompanyModal(companyName) {
  const companyLeads = getCompanyLeads(companyName);
  if (!companyLeads.length) return;
  modalState = { type: "company", contactId: null, companyName, editing: false };
  renderActiveModal();
}

function openContactModal(id) {
  const lead = getLeadById(id);
  if (!lead) return;
  modalState = { type: "contact", contactId: Number(id), companyName: "", editing: false };
  renderActiveModal();
}

function closeContactModal() {
  const modal = document.getElementById("contactModal");
  modalState = { type: "", contactId: null, companyName: "", editing: false };
  updateModalButtons();
  if (modal) modal.setAttribute("aria-hidden", "true");
}

function setMsg(message, color) {
  const el = document.getElementById("syncMsg");
  el.textContent = message || "";
  el.style.color = color || "#1f6d41";
}

function markDbDirty() {
  dbDirty = true;
}

function collectModalValues() {
  const out = {};
  document.querySelectorAll("[data-modal-key]").forEach((el) => {
    const key = text(el.getAttribute("data-modal-key")).trim();
    if (!key) return;
    out[key] = el.value;
  });
  return out;
}

function applyContactModalChanges(values) {
  const lead = getLeadById(modalState.contactId);
  if (!lead) return;
  Object.entries(values).forEach(([key, value]) => {
    lead[key] = value;
  });
  const hasCity = Object.prototype.hasOwnProperty.call(values, "accountCity");
  const hasState = Object.prototype.hasOwnProperty.call(values, "accountState");
  if (hasCity || hasState) {
    lead.accountCityState = composeCityState(lead.accountCity, lead.accountState);
  }
}

function applyCompanyModalChanges(values) {
  const group = getCompanyLeads(modalState.companyName);
  if (!group.length) return;
  Object.entries(values).forEach(([key, value]) => {
    group.forEach((lead) => {
      lead[key] = value;
    });
  });
  const hasCity = Object.prototype.hasOwnProperty.call(values, "accountCity");
  const hasState = Object.prototype.hasOwnProperty.call(values, "accountState");
  if (hasCity || hasState) {
    const merged = composeCityState(values.accountCity, values.accountState);
    group.forEach((lead) => {
      lead.accountCity = text(values.accountCity).trim();
      lead.accountState = text(values.accountState).trim();
      lead.accountCityState = merged;
    });
  }
  if (text(values.company).trim()) {
    modalState.companyName = text(values.company).trim();
  }
}

function getOcrEl(id) {
  return document.getElementById(id);
}

function setOcrStatus(message, color = "#466048") {
  const el = getOcrEl("ocrStatus");
  if (!el) return;
  el.textContent = message || "";
  el.style.color = color;
}

function setOcrBusyState(busy) {
  ocrBusy = !!busy;
  const runBtn = getOcrEl("ocrRun");
  const runAiBtn = getOcrEl("ocrRunAi");
  const addBtn = getOcrEl("ocrAdd");
  const fileEl = getOcrEl("ocrFile");
  if (runBtn) {
    runBtn.disabled = busy;
    runBtn.textContent = busy ? "Reading image..." : "Run OCR";
  }
  if (runAiBtn) {
    runAiBtn.disabled = busy;
    runAiBtn.textContent = busy ? "Reading image..." : "Run AI";
  }
  if (addBtn) addBtn.disabled = busy;
  if (fileEl) fileEl.disabled = busy;
}

function clearOcrForm(keepImage = false) {
  if (!keepImage) {
    ocrImageFile = null;
    const fileEl = getOcrEl("ocrFile");
    const preview = getOcrEl("ocrPreview");
    if (fileEl) fileEl.value = "";
    if (preview) {
      preview.removeAttribute("src");
      preview.style.display = "none";
    }
  }
  [
    "ocrText",
    "ocrName",
    "ocrRole",
    "ocrCompany",
    "ocrBrand",
    "ocrEmail",
    "ocrPhone",
    "ocrLinkedin",
    "ocrWebsite",
    "ocrCity",
    "ocrState",
    "ocrInsight",
  ].forEach((id) => {
    const el = getOcrEl(id);
    if (el) el.value = "";
  });
  const sourceEl = getOcrEl("ocrSource");
  if (sourceEl) sourceEl.value = "Image OCR";
  const statusEl = getOcrEl("ocrStatusSelect");
  const priorityEl = getOcrEl("ocrPrioritySelect");
  if (statusEl) statusEl.value = "New";
  if (priorityEl) priorityEl.value = "Medium";
  ["ocrChannelEmail", "ocrChannelPhone", "ocrChannelLinkedin", "ocrChannelWhatsapp"].forEach((id) => {
    const el = getOcrEl(id);
    if (el) el.checked = false;
  });
  setOcrStatus("");
}

function openOcrModal() {
  const modal = getOcrEl("ocrModal");
  if (!modal) return;
  clearOcrForm(false);
  modal.setAttribute("aria-hidden", "false");
}

function closeOcrModal() {
  const modal = getOcrEl("ocrModal");
  if (!modal) return;
  modal.setAttribute("aria-hidden", "true");
  setOcrBusyState(false);
}

function setOcrImageFile(file) {
  ocrImageFile = file || null;
  const preview = getOcrEl("ocrPreview");
  if (!preview) return;
  if (!ocrImageFile) {
    preview.removeAttribute("src");
    preview.style.display = "none";
    return;
  }
  const src = URL.createObjectURL(ocrImageFile);
  preview.src = src;
  preview.style.display = "block";
  preview.onload = () => URL.revokeObjectURL(src);
}

function hasOcrSignals(textValue) {
  const s = text(textValue);
  return /@|linkedin\.com|www\.|https?:\/\/|\+\d|\bcel\b|\btel\b|\bphone\b|\bmanager\b|\bengenh|\bproject\b/i.test(s);
}

function normalizeOcrText(rawText) {
  return text(rawText)
    .replace(/\r/g, "\n")
    .replace(/[|]/g, "I")
    .replace(/[\u201C\u201D]/g, '"')
    .replace(/[\u2018\u2019]/g, "'")
    .replace(/[^\S\r\n]+/g, " ");
}

function normalizeOcrLine(line) {
  return text(line)
    .replace(/\s+/g, " ")
    .replace(/^[`'"~^*.,:;_|\\/-]+/, "")
    .replace(/[`'"~^*.,:;_|\\/-]+$/, "")
    .trim();
}

function isOcrNoiseLine(line) {
  const n = norm(line);
  if (!n) return true;
  if (/^(?:\d+\s*[v<>]|[\W_]{1,6})$/i.test(n)) return true;
  if (/\b(alt\s*gr|ctrl|shift|caps\s*lock|enter|tab|esc|backspace|delete|insert|home|end|pg\s*up|pg\s*dn)\b/i.test(n)) return true;
  if (/^(?:f\d{1,2}|num\s*lock)$/i.test(n)) return true;
  return false;
}

function mergeOcrTextBlocks(textBlocks) {
  const seen = new Set();
  const out = [];
  (textBlocks || []).forEach((block) => {
    normalizeOcrText(block)
      .split("\n")
      .map(normalizeOcrLine)
      .filter((line) => !isOcrNoiseLine(line))
      .forEach((line) => {
        const key = norm(line);
        if (!key || seen.has(key)) return;
        seen.add(key);
        out.push(line);
      });
  });
  return out.join("\n").trim();
}

async function loadImageElementFromFile(file) {
  return await new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      resolve(img);
    };
    img.onerror = (err) => {
      URL.revokeObjectURL(url);
      reject(err || new Error("Could not load image."));
    };
    img.src = url;
  });
}

function detectCardBoundsFromCanvas(ctx, width, height) {
  const step = Math.max(1, Math.round(Math.max(width, height) / 760));
  const sw = Math.max(32, Math.floor(width / step));
  const sh = Math.max(32, Math.floor(height / step));
  const smallCanvas = document.createElement("canvas");
  smallCanvas.width = sw;
  smallCanvas.height = sh;
  const sctx = smallCanvas.getContext("2d");
  sctx.drawImage(ctx.canvas, 0, 0, width, height, 0, 0, sw, sh);
  const src = sctx.getImageData(0, 0, sw, sh).data;

  const luma = new Float32Array(sw * sh);
  let sum = 0;
  let sq = 0;
  for (let i = 0, p = 0; i < luma.length; i += 1, p += 4) {
    const v = 0.299 * src[p] + 0.587 * src[p + 1] + 0.114 * src[p + 2];
    luma[i] = v;
    sum += v;
    sq += v * v;
  }
  const mean = sum / luma.length;
  const variance = Math.max(0, sq / luma.length - mean * mean);
  const std = Math.sqrt(variance);
  const threshold = Math.max(84, Math.min(220, mean + std * 0.15));

  const mask = new Uint8Array(sw * sh);
  for (let i = 0; i < luma.length; i += 1) {
    mask[i] = luma[i] >= threshold ? 1 : 0;
  }

  const visited = new Uint8Array(sw * sh);
  const qx = new Int32Array(sw * sh);
  const qy = new Int32Array(sw * sh);
  const totalPixels = sw * sh;
  let best = null;

  for (let y = 0; y < sh; y += 1) {
    for (let x = 0; x < sw; x += 1) {
      const start = y * sw + x;
      if (!mask[start] || visited[start]) continue;

      let head = 0;
      let tail = 0;
      visited[start] = 1;
      qx[tail] = x;
      qy[tail] = y;
      tail += 1;

      let minX = x;
      let minY = y;
      let maxX = x;
      let maxY = y;
      let area = 0;

      while (head < tail) {
        const cx = qx[head];
        const cy = qy[head];
        head += 1;
        area += 1;
        if (cx < minX) minX = cx;
        if (cy < minY) minY = cy;
        if (cx > maxX) maxX = cx;
        if (cy > maxY) maxY = cy;

        const neigh = [
          [cx + 1, cy],
          [cx - 1, cy],
          [cx, cy + 1],
          [cx, cy - 1],
        ];
        for (let i = 0; i < neigh.length; i += 1) {
          const nx = neigh[i][0];
          const ny = neigh[i][1];
          if (nx < 0 || ny < 0 || nx >= sw || ny >= sh) continue;
          const ni = ny * sw + nx;
          if (!mask[ni] || visited[ni]) continue;
          visited[ni] = 1;
          qx[tail] = nx;
          qy[tail] = ny;
          tail += 1;
        }
      }

      const bw = maxX - minX + 1;
      const bh = maxY - minY + 1;
      const areaRatio = area / totalPixels;
      const aspect = bw / Math.max(1, bh);
      const fill = area / Math.max(1, bw * bh);
      const centerX = (minX + maxX) / 2;
      const centerY = (minY + maxY) / 2;
      const dx = Math.abs(centerX - sw / 2) / Math.max(1, sw / 2);
      const dy = Math.abs(centerY - sh / 2) / Math.max(1, sh / 2);
      const centerPenalty = dx + dy;

      let score = areaRatio * 8 - centerPenalty * 2;
      if (areaRatio >= 0.07 && areaRatio <= 0.9) score += 3;
      if (aspect >= 1.2 && aspect <= 2.4) score += 4;
      else score -= Math.abs(aspect - 1.7) * 2;
      if (fill >= 0.45) score += 2;

      if (!best || score > best.score) {
        best = { minX, minY, maxX, maxY, score, areaRatio, aspect };
      }
    }
  }

  if (!best || best.areaRatio < 0.04) {
    return { x: 0, y: 0, w: width, h: height };
  }

  const marginX = Math.round((best.maxX - best.minX + 1) * 0.05);
  const marginY = Math.round((best.maxY - best.minY + 1) * 0.06);
  const x = Math.max(0, best.minX - marginX);
  const y = Math.max(0, best.minY - marginY);
  const w = Math.min(sw - x, best.maxX - best.minX + 1 + marginX * 2);
  const h = Math.min(sh - y, best.maxY - best.minY + 1 + marginY * 2);

  return {
    x: Math.max(0, Math.round(x * step)),
    y: Math.max(0, Math.round(y * step)),
    w: Math.max(2, Math.round(w * step)),
    h: Math.max(2, Math.round(h * step)),
  };
}

function createOcrVariantsFromImage(img) {
  const maxBaseSide = 1800;
  const imgW = img.naturalWidth || img.width || 1;
  const imgH = img.naturalHeight || img.height || 1;
  const baseScale = Math.min(1, maxBaseSide / Math.max(imgW, imgH));
  const baseW = Math.max(2, Math.round(imgW * baseScale));
  const baseH = Math.max(2, Math.round(imgH * baseScale));

  const baseCanvas = document.createElement("canvas");
  baseCanvas.width = baseW;
  baseCanvas.height = baseH;
  const bctx = baseCanvas.getContext("2d");
  bctx.drawImage(img, 0, 0, baseW, baseH);

  const bounds = detectCardBoundsFromCanvas(bctx, baseW, baseH);
  const cropCanvas = document.createElement("canvas");
  cropCanvas.width = bounds.w;
  cropCanvas.height = bounds.h;
  const cctx = cropCanvas.getContext("2d");
  cctx.drawImage(baseCanvas, bounds.x, bounds.y, bounds.w, bounds.h, 0, 0, bounds.w, bounds.h);

  const cropRect = (srcCanvas, x, y, w, h) => {
    const out = document.createElement("canvas");
    out.width = Math.max(2, Math.round(w));
    out.height = Math.max(2, Math.round(h));
    const outCtx = out.getContext("2d");
    outCtx.drawImage(srcCanvas, x, y, w, h, 0, 0, out.width, out.height);
    return out;
  };
  const withFilter = (srcCanvas, label, filter, scale) => {
    const out = document.createElement("canvas");
    out.width = Math.max(2, Math.round(srcCanvas.width * scale));
    out.height = Math.max(2, Math.round(srcCanvas.height * scale));
    const outCtx = out.getContext("2d");
    outCtx.filter = filter;
    outCtx.drawImage(srcCanvas, 0, 0, out.width, out.height);
    return { label, image: out };
  };

  const leftCanvas = cropRect(cropCanvas, 0, 0, cropCanvas.width * 0.62, cropCanvas.height);
  const rightCanvas = cropRect(cropCanvas, cropCanvas.width * 0.36, 0, cropCanvas.width * 0.64, cropCanvas.height);

  const upscale = Math.min(2.5, 2200 / Math.max(cropCanvas.width, cropCanvas.height));
  return [
    withFilter(cropCanvas, "full-enhanced", "grayscale(100%) contrast(205%) brightness(128%)", upscale),
    withFilter(cropCanvas, "full-soft", "grayscale(100%) contrast(155%) brightness(112%)", upscale),
    withFilter(leftCanvas, "left-enhanced", "grayscale(100%) contrast(205%) brightness(125%)", Math.min(2.8, upscale + 0.3)),
    withFilter(rightCanvas, "right-enhanced", "grayscale(100%) contrast(205%) brightness(125%)", Math.min(2.8, upscale + 0.3)),
    { label: "cropped", image: cropCanvas },
  ];
}

async function recognizeVariant(variant, loggerPrefix = "") {
  const result = await window.Tesseract.recognize(variant.image, "eng+por", {
    logger: (m) => {
      if (!m || !m.status || !m.status.includes("recognizing text")) return;
      const pct = Math.max(0, Math.min(100, Math.round((m.progress || 0) * 100)));
      setOcrStatus(`${loggerPrefix}${variant.label}: ${pct}%`, "#1f6d41");
    },
  });
  return {
    text: normalizeOcrText(result?.data?.text),
    confidence: Number(result?.data?.confidence) || 0,
  };
}

function scoreOcrCandidate(candidate, label = "") {
  const raw = normalizeOcrText(candidate);
  if (!raw) return -1;
  const lines = raw
    .split("\n")
    .map(normalizeOcrLine)
    .filter((line) => line && !isOcrNoiseLine(line));
  if (!lines.length) return -1;

  let score = 0;
  if (/@/.test(raw)) score += 20;
  if (/(?:\+\d{1,3}\s*)?(?:\(?\d{2,3}\)?\s*)?\d{4,5}[-\s]?\d{4}/.test(raw)) score += 16;
  if (/www\.|https?:\/\/|linkedin\.com/i.test(raw)) score += 12;
  if (/\b(manager|project|engineer|analyst|gerente|engenheiro|analista)\b/i.test(raw)) score += 8;
  if (/\b(ce|sp|rj|mg|es|pr|rs|sc|go|ba|pe|ceara|brasil|brazil)\b/i.test(raw)) score += 6;

  const noiseCount = lines.filter((line) => isOcrNoiseLine(line)).length;
  score -= noiseCount * 5;
  score += Math.min(20, lines.length * 2);
  score += Math.min(14, raw.length / 12);
  if (label.includes("full")) score += 4;
  if (label.includes("left") || label.includes("right")) score += 2;
  return score;
}

function scoreBusinessCardTextCandidate(candidate, label = "") {
  const raw = mergeOcrTextBlocks([candidate]);
  if (!raw) return -120;
  let score = scoreOcrCandidate(raw, label);
  const alphaCount = (raw.match(/[A-Za-zÀ-ÿ]/g) || []).length;
  const digitCount = (raw.match(/\d/g) || []).length;
  if (alphaCount < 8) score -= 30;
  if (raw.length < 24) score -= 20;
  if (/^[\d\W\s{}[\]()<>\-_|]+$/.test(raw)) score -= 60;
  if (digitCount > alphaCount * 1.8) score -= 12;
  if ((raw.match(/[@]/g) || []).length > 4) score -= 8;
  return score;
}

function scoreParsedBusinessCard(parsed) {
  if (!parsed || typeof parsed !== "object") return -100;

  const name = text(parsed.name).trim();
  const role = text(parsed.role).trim();
  const company = text(parsed.company).trim();
  const brand = text(parsed.brand).trim();
  const email = text(parsed.email).trim();
  const phone = text(parsed.phone).trim();
  const linkedin = text(parsed.linkedin).trim();
  const website = text(parsed.website).trim();
  const city = text(parsed.city).trim();
  const state = text(parsed.state).trim();

  let score = 0;
  if (name) score += name.split(/\s+/).length >= 2 ? 24 : 8;
  if (role) score += 10;
  if (company) score += company.length >= 3 ? 20 : 8;
  if (brand) score += brand.length >= 3 ? 8 : 2;
  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) score += 24;
  if (normalizePhoneDigits(phone).length >= 8) score += 18;
  if (linkedin) score += norm(linkedin).includes("linkedin.com") ? 10 : 4;
  if (website) score += 8;
  if (city) score += 6;
  if (state) score += 6;

  if (name && /[\d{}[\]<>]/.test(name)) score -= 14;
  if (company && /^[A-Z0-9]{1,2}$/.test(company)) score -= 16;
  if (brand && /^[A-Z0-9]{1,2}$/.test(brand)) score -= 10;
  if (role && role.length <= 2) score -= 8;
  return score;
}

function pickBestBusinessCardExtraction(candidates) {
  const seen = new Set();
  let best = null;

  (candidates || []).forEach((entry) => {
    const label = text(entry?.label || "candidate").trim();
    const mergedText = mergeOcrTextBlocks([entry?.text || ""]);
    if (!mergedText) return;

    const key = norm(mergedText);
    if (seen.has(key)) return;
    seen.add(key);

    const textScore = scoreBusinessCardTextCandidate(mergedText, label);
    const parsed = parseBusinessCardText(mergedText);
    const parsedScore = scoreParsedBusinessCard(parsed);
    const totalScore = textScore + parsedScore;

    if (!best || totalScore > best.totalScore) {
      best = {
        label,
        text: mergedText,
        parsed,
        textScore,
        parsedScore,
        totalScore,
      };
    }
  });

  return best;
}

const BR_STATE_CODES = new Set([
  "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG",
  "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO",
]);

function isMostlyUpperCase(line) {
  const letters = text(line).replace(/[^A-Za-zÀ-ÿ]/g, "");
  if (!letters) return false;
  const upper = letters.replace(/[^A-ZÀ-Ý]/g, "").length;
  return upper / letters.length >= 0.85;
}

function normalizeDomainToken(value) {
  return text(value)
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]/g, "");
}

function normalizePotentialEmailCandidate(rawValue) {
  let value = text(rawValue).toLowerCase();
  if (!value) return "";
  value = value.replace(/[<>\[\](){}]/g, " ");
  value = value.replace(/\s+at\s+/g, "@");
  value = value.replace(/\s*@\s*/g, "@");
  value = value.replace(/([a-z0-9])\s+([a-z0-9])(?=[^@]*@)/g, "$1.$2");
  value = value.replace(/\s+/g, "");
  value = value.replace(/@([a-z0-9-]+)coml?br\b/g, "@$1.com.br");
  value = value.replace(/@([a-z0-9-]+)com\b/g, "@$1.com");
  value = value.replace(/@([a-z0-9-]+)net\b/g, "@$1.net");
  value = value.replace(/@([a-z0-9-]+)org\b/g, "@$1.org");
  value = value.replace(/\.{2,}/g, ".");
  value = value.replace(/^-+|-+$/g, "");
  return value;
}

function extractEmailsFromOcrLines(lines) {
  const strictRegex = /[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}/gi;
  const out = [];
  const pushMatches = (source) => {
    const matches = text(source).match(strictRegex) || [];
    matches.forEach((m) => out.push(m.toLowerCase()));
  };

  pushMatches(lines.join("\n"));
  lines.forEach((line) => {
    if (!line.includes("@")) return;
    pushMatches(normalizePotentialEmailCandidate(line));
  });

  return uniqValues(out);
}

function normalizeWebsiteCandidate(rawValue) {
  let value = text(rawValue).toLowerCase();
  if (!value) return "";
  if (value.includes("@")) return "";

  value = value.replace(/[,;'"`]+/g, " ");
  value = value.replace(/\b(vnw|vww|wvw|wwv|vvww|vvv)\b/g, "www");
  value = value.replace(/\b([a-z0-9-]+)\s+coml?brasil\b/g, "$1.com.br");
  value = value.replace(/\b([a-z0-9-]+)\s+coml?br\b/g, "$1.com.br");
  value = value.replace(/\b([a-z0-9-]+)\s+com\s*\/?\s*br(?:asil)?\b/g, "$1.com.br");
  value = value.replace(/comlbr/g, "com/br");
  value = value.replace(/coml/g, "com/");
  value = value.replace(/combr/g, "com.br");
  value = value.replace(/\s*\/\s*/g, "/");
  value = value.replace(/\bwww\s+([a-z0-9-]+\.[a-z]{2,})\b/g, "www.$1");
  value = value.replace(/\b([a-z0-9-]+)\s+(com|net|org|io|ai|br)\b/g, "$1.$2");
  value = value.replace(/\s+/g, "");
  value = value.replace(/^www(?=[a-z0-9-]+\.)/, "www.");
  value = value.replace(/^[^a-z0-9]+/, "");
  if (!/\.[a-z]{2,}/.test(value)) return "";
  if (!/^https?:\/\//.test(value)) value = `https://${value}`;

  try {
    const parsed = new URL(value);
    const hostname = text(parsed.hostname).trim();
    if (!hostname || hostname.split(".").length < 2) return "";
    const pathname = parsed.pathname && parsed.pathname !== "/" ? parsed.pathname : "";
    return `${parsed.protocol}//${hostname}${pathname}`;
  } catch (_) {
    return "";
  }
}

function extractWebsitesFromOcrLines(lines, emails) {
  const out = [];
  const domainsFromEmail = new Set(
    (emails || [])
      .map((mail) => text(mail).split("@")[1] || "")
      .map((domain) => norm(domain))
      .filter(Boolean)
  );

  const pushCandidate = (candidate) => {
    const normalized = normalizeWebsiteCandidate(candidate);
    if (!normalized) return;
    const host = norm(text(normalized).replace(/^https?:\/\//, "").split("/")[0]);
    if (!host) return;
    out.push(normalized);
    if (domainsFromEmail.has(host)) return;
  };

  const joined = lines.join(" ");
  const regex = /(?:https?:\/\/)?(?:www\.)?[a-z0-9-]+(?:\.[a-z0-9-]+)+(?:\/[a-z0-9._%\-\/]*)?/gi;
  (joined.match(regex) || []).forEach((item) => pushCandidate(item));
  lines.forEach((line) => {
    if (!/\b(www|\.com|\.br|\.net|\.org|http)\b/i.test(line) && !/\bcoml?\b/i.test(line)) return;
    pushCandidate(line);
  });

  const uniq = uniqValues(out);
  return uniq.sort((a, b) => {
    const aHost = norm(text(a).replace(/^https?:\/\//, ""));
    const bHost = norm(text(b).replace(/^https?:\/\//, ""));
    const aIsLinkedin = aHost.includes("linkedin.com");
    const bIsLinkedin = bHost.includes("linkedin.com");
    if (aIsLinkedin === bIsLinkedin) return 0;
    return aIsLinkedin ? 1 : -1;
  });
}

function pickCityStateFromLines(lines, textJoined) {
  const clean = lines.map((line) => normalizeOcrLine(line)).filter(Boolean);
  for (let i = 0; i < clean.length; i += 1) {
    const current = clean[i].toUpperCase().replace(/\./g, "").trim();
    if (!BR_STATE_CODES.has(current)) continue;
    if (i > 0) {
      const cityLine = clean[i - 1].replace(/[,;:-]+$/, "").trim();
      if (cityLine && cityLine.length <= 42 && !/\d/.test(cityLine) && !/\b(cep|av\.?|rua|distrito|district)\b/i.test(cityLine)) {
        return { city: toTitleCase(cityLine), state: current };
      }
    }
  }

  for (let i = 2; i < clean.length; i += 1) {
    if (!/\b(brasil|brazil)\b/i.test(clean[i])) continue;
    const stateMaybe = clean[i - 1].toUpperCase().replace(/\./g, "").trim();
    const cityMaybe = clean[i - 2].replace(/[,;:-]+$/, "").trim();
    if (BR_STATE_CODES.has(stateMaybe) && cityMaybe && !/\d/.test(cityMaybe)) {
      return { city: toTitleCase(cityMaybe), state: stateMaybe };
    }
  }

  const fallback = text(textJoined).match(/([A-Za-zÀ-ÿ.'\-\s]{2,})\s*[,\/-]\s*([A-Z]{2})\b/);
  if (fallback) {
    const city = toTitleCase(fallback[1]);
    const state = text(fallback[2]).trim().toUpperCase();
    if (BR_STATE_CODES.has(state)) return { city, state };
  }
  return { city: "", state: "" };
}

function isLikelyPersonName(line) {
  const value = text(line).trim();
  if (!value) return false;
  if (/\d|@|https?:\/\/|www\.|linkedin\.com/i.test(value)) return false;
  if (/\b(cep|av\.?|avenida|rua|distrito|district|brasil|brazil)\b/i.test(value)) return false;
  const words = value.split(/\s+/).filter(Boolean);
  if (words.length < 2 || words.length > 5) return false;
  const titleLike = words.filter((w) => /^[A-ZÀ-Ý][a-zà-ÿ'`-]{1,}$/.test(w)).length;
  return titleLike >= 2;
}

function extractMemberGroupBrand(lines) {
  for (const line of lines || []) {
    const m1 = text(line).match(/\bmember\w*\s+of\s+([A-Za-zÀ-ÿ0-9&.\- ]{2,})/i);
    if (m1 && m1[1]) return normalizeOcrLine(m1[1]);
    const m2 = text(line).match(/\bmember\w*\s+([A-Za-zÀ-ÿ0-9&.\- ]{2,})/i);
    if (m2 && m2[1]) return normalizeOcrLine(m2[1]);
  }
  return "";
}

function looksLikeLegalEntityName(line) {
  const value = text(line);
  if (!value) return false;
  return /\b(ltda|s\.?a\.?|inc\b|corp\b|llc\b|holdings?\b|do brasil|brasil)\b/i.test(value);
}

function parseBusinessCardText(rawText) {
  const raw = mergeOcrTextBlocks([rawText]);
  const lines = raw
    .split("\n")
    .map(normalizeOcrLine)
    .filter((line) => line && !isOcrNoiseLine(line))
    .filter((line) => line.length > 1 || BR_STATE_CODES.has(line.toUpperCase()));
  const textJoined = lines.join("\n");

  const emails = extractEmailsFromOcrLines(lines);
  const phones = uniqValues(
    (textJoined.match(/(?:\+\d{1,3}\s*)?(?:\(?\d{2,3}\)?\s*)?\d{4,5}[-\s]?\d{4}/g) || []).map((v) => v.replace(/\s{2,}/g, " ").trim())
  );
  const websites = extractWebsitesFromOcrLines(lines, emails);
  const linkedin = pickFirst(websites.filter((u) => norm(u).includes("linkedin.com")));
  const websiteCandidates = websites.filter((u) => !norm(u).includes("linkedin.com"));
  let website = "";

  const roleHintRegex =
    /\b(project manager|manager|director|coordinator|analyst|engineer|specialist|buyer|procurement|founder|owner|supervisor|leader|gerente|diretor|coordenador|analista|engenheiro|comprador|supply|maintenance|comercial|marketing|vendas|sales)\b/i;
  const addressHintRegex = /\b(av\.?|avenida|rua|street|distrito|district|cep|postal|bairro|brasil|brazil)\b/i;
  const memberHintRegex = /\bmember\w*(?:\s+of)?\b/i;
  let role = pickFirst(lines.filter((line) => roleHintRegex.test(line)));

  const lineHasNoise = (line) =>
    !line ||
    line.length < 3 ||
    isOcrNoiseLine(line) ||
    /@|https?:\/\/|www\.|linkedin\.com/i.test(line) ||
    /\d{4,}/.test(line) ||
    /^(\+?\d[\d\s\-().]{7,})$/.test(line);

  const nameCandidates = lines
    .map((line, idx) => {
      if (lineHasNoise(line)) return null;
      if (!isLikelyPersonName(line)) return null;
      const words = line.split(/\s+/).filter(Boolean);
      let score = 0;
      if (idx <= 5) score += 3;
      if (words.length === 2 || words.length === 3) score += 2;
      if (isMostlyUpperCase(line)) score -= 4;
      if (roleHintRegex.test(line)) score -= 3;
      return { line, score };
    })
    .filter(Boolean)
    .sort((a, b) => b.score - a.score);
  const name = nameCandidates.length ? nameCandidates[0].line : "";

  const companyKeyword = /\b(ltda|s\.a|sa\b|inc\b|corp\b|company|group|holding|solutions|industria|engenharia|elantas|altana|von roll)\b/i;
  const companyCandidates = lines
    .map((line, idx) => {
      if (lineHasNoise(line)) return null;
      if (name && norm(line) === norm(name)) return null;
      const cleanLine = line
        .replace(/\bmember of\b.*/i, "")
        .replace(/^(?:o|a)\s+(?=[A-ZÀ-Ý]{3,})/i, "")
        .replace(/^[^A-Za-zÀ-ÿ0-9]+/, "")
        .trim();
      if (!cleanLine) return null;
      let score = 0;
      if (companyKeyword.test(cleanLine)) score += 5;
      if (/^[A-Z0-9&.,\-\s]{4,}$/.test(cleanLine)) score += 3;
      if (isMostlyUpperCase(cleanLine)) score += 2;
      if (idx <= 6) score += 2;
      if (addressHintRegex.test(cleanLine)) score -= 4;
      if (memberHintRegex.test(cleanLine)) score -= 6;
      if (roleHintRegex.test(cleanLine) && !isMostlyUpperCase(cleanLine)) score -= 3;
      if (isLikelyPersonName(cleanLine)) score -= 4;
      if (cleanLine.length > 45) score -= 2;
      return { line: cleanLine, score, idx };
    })
    .filter(Boolean)
    .filter((item) => item.score > 0)
    .sort((a, b) => (b.score === a.score ? a.idx - b.idx : b.score - a.score));
  const firstCompanyCandidate = companyCandidates.length ? companyCandidates[0].line : "";
  const legalCompanyCandidate = companyCandidates.find((item) => looksLikeLegalEntityName(item.line))?.line || "";
  const memberGroupBrand = extractMemberGroupBrand(lines);
  const nonLegalCompanyCandidate =
    companyCandidates.find((item) => !looksLikeLegalEntityName(item.line) && norm(item.line) !== norm(legalCompanyCandidate))?.line || "";

  const cityState = pickCityStateFromLines(lines, textJoined);
  let city = cityState.city;
  let state = cityState.state;

  if (!role && name) {
    const nameIndex = lines.findIndex((line) => norm(line) === norm(name));
    if (nameIndex >= 0) {
      const next = lines[nameIndex + 1] || "";
      if (roleHintRegex.test(next)) role = next;
    }
  }

  let normalizedName = name || "";
  if (!normalizedName && emails.length) {
    const local = text(emails[0]).split("@")[0] || "";
    const pieces = local.split(/[._-]+/).filter((p) => p.length > 1);
    if (pieces.length >= 2) {
      normalizedName = pieces.map((p) => p.charAt(0).toUpperCase() + p.slice(1).toLowerCase()).join(" ");
    }
  }

  let normalizedCompany = legalCompanyCandidate || firstCompanyCandidate || "";
  let normalizedBrand = "";
  if (nonLegalCompanyCandidate && norm(nonLegalCompanyCandidate) !== norm(normalizedCompany)) {
    normalizedBrand = nonLegalCompanyCandidate;
  } else if (memberGroupBrand && norm(memberGroupBrand) !== norm(normalizedCompany)) {
    normalizedBrand = memberGroupBrand;
  }

  const websiteSeed = pickFirst(websiteCandidates);
  if (!normalizedCompany && websiteSeed) {
    const base = text(websiteSeed).replace(/^https?:\/\//i, "").replace(/^www\./i, "").split("/")[0];
    const token = base.split(".")[0];
    if (token && token.length >= 3) {
      normalizedCompany = token.toUpperCase();
    }
  }

  const preferredDomainTokens = uniqValues([normalizedBrand, normalizedCompany].map(normalizeDomainToken).filter((t) => t.length >= 4));
  if (websiteCandidates.length) {
    const byEntity = websiteCandidates.find((candidate) => {
      const host = normalizeDomainToken(text(candidate).replace(/^https?:\/\//i, "").split("/")[0]);
      if (!host) return false;
      return preferredDomainTokens.some((token) => host.includes(token));
    });
    website = byEntity || pickFirst(websiteCandidates);
  }

  if (!website && emails.length) {
    const domain = text(emails[0]).split("@")[1] || "";
    if (domain && domain.includes(".")) website = `https://${domain}`;
  }

  if (!normalizedCompany && normalizedBrand) {
    normalizedCompany = normalizedBrand;
  }

  const insightParts = [];
  if (normalizedBrand) insightParts.push(`Brand: ${normalizedBrand}`);
  if (memberGroupBrand && norm(memberGroupBrand) !== norm(normalizedBrand) && norm(memberGroupBrand) !== norm(normalizedCompany)) {
    insightParts.push(`Parent group: ${memberGroupBrand}`);
  }
  if (website) insightParts.push(`Website: ${website}`);
  const addressLines = lines.filter((line) => addressHintRegex.test(line)).slice(0, 3);
  if (addressLines.length) insightParts.push(`Address: ${addressLines.join(" | ")}`);
  const insight = insightParts.length ? insightParts.join(" | ") : lines.slice(0, 6).join(" | ");

  return {
    name: normalizedName || "",
    role: role || "",
    company: normalizedCompany || "",
    brand: normalizedBrand || "",
    email: pickFirst(emails),
    phone: pickFirst(phones),
    linkedin: linkedin || "",
    website: website || "",
    city,
    state,
    insight,
  };
}

function applyOcrParsedData(parsed) {
  getOcrEl("ocrName").value = text(parsed.name).trim();
  getOcrEl("ocrRole").value = text(parsed.role).trim();
  getOcrEl("ocrCompany").value = text(parsed.company).trim();
  getOcrEl("ocrBrand").value = text(parsed.brand).trim();
  getOcrEl("ocrEmail").value = text(parsed.email).trim();
  getOcrEl("ocrPhone").value = text(parsed.phone).trim();
  getOcrEl("ocrLinkedin").value = text(parsed.linkedin).trim();
  getOcrEl("ocrWebsite").value = text(parsed.website).trim();
  getOcrEl("ocrCity").value = text(parsed.city).trim();
  getOcrEl("ocrState").value = text(parsed.state).trim();
  getOcrEl("ocrInsight").value = text(parsed.insight).trim();

  const inferredChannels = channelSetFromContactFields(parsed);
  const cEmail = getOcrEl("ocrChannelEmail");
  const cPhone = getOcrEl("ocrChannelPhone");
  const cLinkedin = getOcrEl("ocrChannelLinkedin");
  const cWhatsapp = getOcrEl("ocrChannelWhatsapp");
  if (cEmail) cEmail.checked = inferredChannels.has("Email");
  if (cPhone) cPhone.checked = inferredChannels.has("Phone");
  if (cLinkedin) cLinkedin.checked = inferredChannels.has("LinkedIn");
  if (cWhatsapp) cWhatsapp.checked = false;
}

function readFileAsDataUrl(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(text(reader.result));
    reader.onerror = () => reject(new Error("Could not read image file."));
    reader.readAsDataURL(file);
  });
}

function getStoredAiKey(provider) {
  const p = norm(provider);
  const storageKey = p === "gemini" ? AI_KEY_GEMINI_STORAGE : AI_KEY_OPENAI_STORAGE;
  try {
    return text(localStorage.getItem(storageKey)).trim();
  } catch (_) {
    return "";
  }
}

function storeAiKey(provider, value) {
  const p = norm(provider);
  const storageKey = p === "gemini" ? AI_KEY_GEMINI_STORAGE : AI_KEY_OPENAI_STORAGE;
  try {
    localStorage.setItem(storageKey, text(value).trim());
  } catch (_) {}
}

function getPreferredAiProvider() {
  try {
    const saved = norm(localStorage.getItem(AI_PROVIDER_STORAGE));
    if (saved === "gemini" || saved === "openai") return saved;
  } catch (_) {}
  return "gemini";
}

function setPreferredAiProvider(provider) {
  const p = norm(provider);
  if (p !== "gemini" && p !== "openai") return;
  try {
    localStorage.setItem(AI_PROVIDER_STORAGE, p);
  } catch (_) {}
}

function keyProviderFromValue(value) {
  const v = text(value).trim();
  if (!v) return "";
  if (/^AIza[0-9A-Za-z\-_]{20,}$/.test(v)) return "gemini";
  if (/^sk-[A-Za-z0-9\-_]{20,}$/.test(v)) return "openai";
  return "";
}

function resolveAiConfig() {
  const preferred = getPreferredAiProvider();
  const preferredKey = getStoredAiKey(preferred);
  if (preferredKey) return { provider: preferred, apiKey: preferredKey };

  const fallbackProvider = preferred === "gemini" ? "openai" : "gemini";
  const fallbackKey = getStoredAiKey(fallbackProvider);
  if (fallbackKey) {
    setPreferredAiProvider(fallbackProvider);
    return { provider: fallbackProvider, apiKey: fallbackKey };
  }

  const typed = text(
    prompt(
      "Paste your AI key: Gemini (free tier) key starts with AIza...; OpenAI key starts with sk-.... It will be saved only in this browser.",
      ""
    )
  ).trim();
  if (!typed) return { provider: "", apiKey: "" };

  const detected = keyProviderFromValue(typed);
  if (!detected) {
    return { provider: "", apiKey: "" };
  }
  storeAiKey(detected, typed);
  setPreferredAiProvider(detected);
  return { provider: detected, apiKey: typed };
}

function splitDataUrl(dataUrl) {
  const raw = text(dataUrl).trim();
  const m = raw.match(/^data:([^;]+);base64,(.+)$/);
  if (!m) return { mimeType: "image/jpeg", base64: "" };
  return { mimeType: m[1], base64: m[2] };
}

function parseJsonLoose(raw) {
  const source = text(raw).trim();
  if (!source) return null;
  const directTry = () => {
    try {
      return JSON.parse(source);
    } catch (_) {
      return null;
    }
  };
  const direct = directTry();
  if (direct) return direct;

  const fenced = source.match(/```(?:json)?\s*([\s\S]+?)```/i);
  if (fenced && fenced[1]) {
    try {
      return JSON.parse(fenced[1].trim());
    } catch (_) {}
  }
  const first = source.indexOf("{");
  const last = source.lastIndexOf("}");
  if (first >= 0 && last > first) {
    try {
      return JSON.parse(source.slice(first, last + 1));
    } catch (_) {}
  }
  return null;
}

function normalizeAiChannels(value) {
  const out = new Set();
  if (Array.isArray(value)) {
    value.forEach((item) => {
      const token = canonicalChannelToken(item);
      if (token && token !== "NO_CONTACT") out.add(token);
    });
    return out;
  }
  parseChannelSet(value).forEach((item) => out.add(item));
  return out;
}

function normalizeAiExtract(payload) {
  const src = payload && typeof payload === "object" ? payload : {};
  const mapped = {
    name: text(src.name || src.contact_name || "").trim(),
    role: text(src.role || src.title || src.job_title || "").trim(),
    company: text(src.company || src.company_name || "").trim(),
    brand: text(src.brand || src.company_brand || src.account_brand || "").trim(),
    email: text(src.email || "").trim(),
    phone: text(src.phone || src.mobile || src.cell || "").trim(),
    linkedin: text(src.linkedin || src.linkedin_url || "").trim(),
    website: text(src.website || src.url || "").trim(),
    city: text(src.city || "").trim(),
    state: text(src.state || src.region || "").trim(),
    insight: text(src.insight || src.notes || src.observations || "").trim(),
    rawText: text(src.raw_text || src.ocr_text || src.transcript || "").trim(),
    channelSet: normalizeAiChannels(src.channels || src.channel || src.contact_channels || []),
  };

  if (!mapped.channelSet.size) {
    channelSetFromContactFields(mapped).forEach((item) => mapped.channelSet.add(item));
  }
  return mapped;
}

async function requestAiExtractOpenAi(imageUrl, apiKey, promptText) {
  const response = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${apiKey}`,
    },
    body: JSON.stringify({
      model: AI_OPENAI_MODEL,
      temperature: 0,
      response_format: { type: "json_object" },
      messages: [
        {
          role: "system",
          content: "You are a precise business-card extractor. Return only valid JSON.",
        },
        {
          role: "user",
          content: [
            { type: "text", text: promptText },
            { type: "image_url", image_url: { url: imageUrl } },
          ],
        },
      ],
    }),
  });

  if (!response.ok) {
    const fail = await response.text();
    throw new Error(`OpenAI request failed (${response.status}): ${fail.slice(0, 180)}`);
  }
  const payload = await response.json();
  return text(payload?.choices?.[0]?.message?.content).trim();
}

async function requestAiExtractGemini(imageUrl, apiKey, promptText) {
  const parts = splitDataUrl(imageUrl);
  if (!parts.base64) throw new Error("Could not prepare image payload for Gemini.");

  const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${AI_GEMINI_MODEL}:generateContent?key=${encodeURIComponent(apiKey)}`;
  const response = await fetch(endpoint, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      contents: [
        {
          role: "user",
          parts: [
            { text: promptText },
            {
              inline_data: {
                mime_type: parts.mimeType || "image/jpeg",
                data: parts.base64,
              },
            },
          ],
        },
      ],
      generationConfig: {
        temperature: 0,
        responseMimeType: "application/json",
      },
    }),
  });

  if (!response.ok) {
    const fail = await response.text();
    throw new Error(`Gemini request failed (${response.status}): ${fail.slice(0, 180)}`);
  }
  const payload = await response.json();
  const candidate = payload?.candidates?.[0];
  const textParts = (candidate?.content?.parts || [])
    .map((part) => text(part?.text).trim())
    .filter(Boolean);
  return textParts.join("\n").trim();
}

async function runAiFromSelectedImage() {
  if (!ocrImageFile) {
    setOcrStatus("Select an image first.", "#b36b00");
    return;
  }
  if (typeof fetch !== "function") {
    setOcrStatus("fetch() not available in this browser.", "#b71c1c");
    return;
  }

  setOcrBusyState(true);
  const tStart = perfNow();
  try {
    setOcrStatus("Sending image to local OCR API (port 8008)...", "#1f6d41");

    const formData = new FormData();
    formData.append("file", ocrImageFile);
    formData.append("cleanup_with_llm", "true");
    formData.append("model", "llama3.1:8b");

    let resp;
    const tApiStart = perfNow();
    try {
      resp = await fetch("http://127.0.0.1:8008/ocr", { method: "POST", body: formData });
    } catch (networkError) {
      throw new Error("Local OCR API not reachable. Make sure the server is running (port 8008).");
    }

    if (!resp.ok) {
      const errBody = await resp.text().catch(() => "");
      throw new Error(`OCR API error ${resp.status}: ${errBody}`);
    }

    const json = await resp.json();
    const tApiEnd = perfNow();
    const tParseStart = perfNow();
    const finalText = text(json.final_text).trim();
    const rawText = text(json.raw_text).trim();
    const mergedText = mergeOcrTextBlocks([rawText, finalText]);
    const candidates = [
      { label: "api_final", text: finalText },
      { label: "api_raw", text: rawText },
      { label: "api_merged", text: mergedText },
    ];
    const best = pickBestBusinessCardExtraction(candidates);
    const chosenText = best?.text || mergedText || rawText || finalText || "";
    const chosenParsed = best?.parsed || parseBusinessCardText(chosenText);

    const rawTextEl = getOcrEl("ocrText");
    if (rawTextEl) rawTextEl.value = chosenText;
    applyOcrParsedData(chosenParsed);
    const tParseEnd = perfNow();
    const tEnd = perfNow();

    const avgConf = Number(json.avg_confidence);
    const confLabel = Number.isFinite(avgConf) ? ` | conf ${Math.round(avgConf * 100)}%` : "";
    const sourceLabel = best?.label ? ` (${best.label})` : "";
    const perfLabel = ` | API ${fmtMs(tApiEnd - tApiStart)} | parse ${fmtMs(tParseEnd - tParseStart)} | total ${fmtMs(tEnd - tStart)}`;
    setOcrStatus(`Local AI extraction completed${sourceLabel}${confLabel}${perfLabel}. Review fields before adding.`, "#1e8449");
    logPerf("Run AI", {
      model: "llama3.1:8b",
      source: best?.label || "",
      confidence: avgConf,
      apiMs: Math.round(tApiEnd - tApiStart),
      parseMs: Math.round(tParseEnd - tParseStart),
      totalMs: Math.round(tEnd - tStart),
    });
  } catch (error) {
    console.error(error);
    const tEnd = perfNow();
    setOcrStatus(`Local OCR failed after ${fmtMs(tEnd - tStart)}: ${error?.message || "unknown error"}`, "#b71c1c");
  } finally {
    setOcrBusyState(false);
  }
}

async function runOcrFromSelectedImage() {
  if (!ocrImageFile) {
    setOcrStatus("Select an image first.", "#b36b00");
    return;
  }
  if (!window.Tesseract || typeof window.Tesseract.recognize !== "function") {
    setOcrStatus("OCR engine not available in this browser.", "#b71c1c");
    return;
  }

  setOcrBusyState(true);
  const tStart = perfNow();
  try {
    setOcrStatus("Preparing image for OCR...", "#1f6d41");
    const tPrepStart = perfNow();
    const img = await loadImageElementFromFile(ocrImageFile);
    const variants = createOcrVariantsFromImage(img);
    const tPrepEnd = perfNow();
    const candidates = [];
    let ocrEngineMs = 0;

    for (let i = 0; i < variants.length; i += 1) {
      const tVariantStart = perfNow();
      const result = await recognizeVariant(variants[i], "OCR ");
      const tVariantEnd = perfNow();
      ocrEngineMs += tVariantEnd - tVariantStart;
      const candidate = text(result.text).trim();
      if (!candidate) continue;
      const score = result.confidence + scoreOcrCandidate(candidate, variants[i].label) + (hasOcrSignals(candidate) ? 10 : 0);
      candidates.push({
        label: variants[i].label,
        text: candidate,
        confidence: result.confidence,
        score,
        elapsedMs: Math.round(tVariantEnd - tVariantStart),
      });
    }

    const tParseStart = perfNow();
    candidates.sort((a, b) => b.score - a.score);
    const bestFull = candidates.find((c) => c.label.includes("full")) || candidates[0] || null;
    const bestLeft = candidates.find((c) => c.label.includes("left")) || null;
    const bestRight = candidates.find((c) => c.label.includes("right")) || null;
    const topOther = candidates.filter((c) => c !== bestFull && c !== bestLeft && c !== bestRight).slice(0, 1);
    const recognized = mergeOcrTextBlocks([
      bestFull?.text || "",
      bestLeft?.text || "",
      bestRight?.text || "",
      ...topOther.map((c) => c.text),
    ]);

    const extractionCandidates = [
      { label: "merged", text: recognized },
      ...candidates.map((c) => ({ label: `variant_${c.label}`, text: c.text })),
    ];
    const best = pickBestBusinessCardExtraction(extractionCandidates);
    const chosenText = best?.text || recognized;
    const chosenParsed = best?.parsed || parseBusinessCardText(chosenText);

    getOcrEl("ocrText").value = chosenText;
    applyOcrParsedData(chosenParsed);
    const tParseEnd = perfNow();
    const tEnd = perfNow();
    if (recognized) {
      const sourceLabel = best?.label ? ` (${best.label})` : "";
      const perfLabel = ` | prep ${fmtMs(tPrepEnd - tPrepStart)} | OCR ${fmtMs(ocrEngineMs)} | parse ${fmtMs(tParseEnd - tParseStart)} | total ${fmtMs(tEnd - tStart)}`;
      setOcrStatus(`OCR completed with multi-region extraction${sourceLabel}${perfLabel}. Review fields before adding.`, "#1e8449");
      logPerf("Run OCR", {
        variantsTried: variants.length,
        candidates: candidates.length,
        source: best?.label || "",
        prepMs: Math.round(tPrepEnd - tPrepStart),
        ocrMs: Math.round(ocrEngineMs),
        parseMs: Math.round(tParseEnd - tParseStart),
        totalMs: Math.round(tEnd - tStart),
      });
    } else {
      setOcrStatus("OCR could not detect readable text. Try a closer/clearer photo.", "#b36b00");
    }
  } catch (error) {
    console.error(error);
    const tEnd = perfNow();
    setOcrStatus(`Failed to read image after ${fmtMs(tEnd - tStart)}. Try another image quality.`, "#b71c1c");
  } finally {
    setOcrBusyState(false);
  }
}

function collectOcrChannels() {
  const set = new Set();
  if (getOcrEl("ocrChannelEmail")?.checked) set.add("Email");
  if (getOcrEl("ocrChannelPhone")?.checked) set.add("Phone");
  if (getOcrEl("ocrChannelLinkedin")?.checked) set.add("LinkedIn");
  if (getOcrEl("ocrChannelWhatsapp")?.checked) set.add("WhatsApp");
  return set;
}

function collectOcrFormValues() {
  return {
    name: text(getOcrEl("ocrName")?.value).trim(),
    role: text(getOcrEl("ocrRole")?.value).trim(),
    company: text(getOcrEl("ocrCompany")?.value).trim(),
    brand: text(getOcrEl("ocrBrand")?.value).trim(),
    email: text(getOcrEl("ocrEmail")?.value).trim(),
    phone: text(getOcrEl("ocrPhone")?.value).trim(),
    linkedin: text(getOcrEl("ocrLinkedin")?.value).trim(),
    website: text(getOcrEl("ocrWebsite")?.value).trim(),
    city: text(getOcrEl("ocrCity")?.value).trim(),
    state: text(getOcrEl("ocrState")?.value).trim(),
    status: text(getOcrEl("ocrStatusSelect")?.value).trim() || "New",
    priority: text(getOcrEl("ocrPrioritySelect")?.value).trim() || "Medium",
    source: text(getOcrEl("ocrSource")?.value).trim() || "Image OCR",
    insight: text(getOcrEl("ocrInsight")?.value).trim(),
    channelSet: collectOcrChannels(),
    ocrText: text(getOcrEl("ocrText")?.value).trim(),
  };
}

function findOcrDuplicates(values) {
  const incomingNameKey = normalizePersonName(values.name);
  const incomingCompanyKey = norm(values.company);
  const sameName = leads.filter((lead) => incomingNameKey && normalizePersonName(lead.name) === incomingNameKey);
  const sameNameCompany = leads.filter(
    (lead) =>
      incomingNameKey &&
      incomingCompanyKey &&
      normalizePersonName(lead.name) === incomingNameKey &&
      norm(lead.company) === incomingCompanyKey
  );
  const sameEmail = leads.filter((lead) => values.email && norm(lead.email) === norm(values.email));
  const phoneDigits = normalizePhoneDigits(values.phone);
  const samePhone = leads.filter((lead) => phoneDigits && phoneDigits.length >= 8 && normalizePhoneDigits(lead.phone) === phoneDigits);
  const sameCompanyCount = leads.filter((lead) => values.company && norm(lead.company) === norm(values.company)).length;
  return { sameName, sameNameCompany, sameEmail, samePhone, sameCompanyCount };
}

function pickBestDuplicateLead(candidates) {
  if (!Array.isArray(candidates) || !candidates.length) return null;
  const score = (lead) => {
    let s = 0;
    if (text(lead.email).trim()) s += 3;
    if (normalizePhoneDigits(lead.phone).length >= 8) s += 3;
    if (text(lead.linkedin).trim()) s += 2;
    if (text(lead.role).trim()) s += 2;
    if (text(lead.owner).trim()) s += 1;
    if (text(lead.notes).trim()) s += 1;
    return s;
  };
  return [...candidates].sort((a, b) => {
    const diff = score(b) - score(a);
    if (diff) return diff;
    return Number(a.id) - Number(b.id);
  })[0];
}

function findBestOcrDuplicate(values, dup) {
  const hasName = !!normalizePersonName(values.name);
  if (hasName) {
    if (dup.sameNameCompany.length) return { lead: pickBestDuplicateLead(dup.sameNameCompany), reason: "name+company", ambiguous: [] };
    if (dup.sameName.length === 1) return { lead: dup.sameName[0], reason: "name", ambiguous: [] };
    if (dup.sameName.length > 1) return { lead: null, reason: "name-ambiguous", ambiguous: dup.sameName };
  }

  if (dup.sameEmail.length) return { lead: pickBestDuplicateLead(dup.sameEmail), reason: "email", ambiguous: [] };
  if (dup.samePhone.length) return { lead: pickBestDuplicateLead(dup.samePhone), reason: "phone", ambiguous: [] };
  return { lead: null, reason: "", ambiguous: [] };
}

function betterText(currentValue, incomingValue) {
  const current = text(currentValue).trim();
  const incoming = text(incomingValue).trim();
  if (!incoming) return current;
  if (!current) return incoming;
  if (norm(current) === norm(incoming)) return current;
  if (incoming.length > current.length + 4) return incoming;
  return current;
}

function normalizePersonName(value) {
  return text(value)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9\s]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function mergeNote(currentValue, incomingValue) {
  const current = text(currentValue).trim();
  const incoming = text(incomingValue).trim();
  if (!incoming) return current;
  if (!current) return incoming;
  if (norm(current).includes(norm(incoming))) return current;
  if (norm(incoming).includes(norm(current))) return incoming;
  return `${current}\n---\n${incoming}`;
}

function mergeLeadFromOcr(existingLead, values) {
  if (!existingLead) return false;
  const before = JSON.stringify(existingLead);

  existingLead.name = betterText(existingLead.name, values.name);
  existingLead.company = betterText(existingLead.company, values.company);
  existingLead.role = betterText(existingLead.role, values.role);
  existingLead.email = betterText(existingLead.email, values.email);
  existingLead.phone = betterText(existingLead.phone, values.phone);
  existingLead.linkedin = betterText(existingLead.linkedin, values.linkedin);
  existingLead.owner = betterText(existingLead.owner, values.insight);
  existingLead.notes = mergeNote(existingLead.notes, values.ocrText);

  const incomingCity = text(values.city).trim();
  const incomingState = text(values.state).trim().toUpperCase();
  existingLead.accountCity = betterText(existingLead.accountCity, incomingCity);
  existingLead.accountState = betterText(existingLead.accountState, incomingState);
  existingLead.accountCityState = composeCityState(existingLead.accountCity, existingLead.accountState);
  existingLead.accountWebsite = betterText(existingLead.accountWebsite, values.website);
  existingLead.accountPhone = betterText(existingLead.accountPhone, values.phone);
  existingLead.accountBrand = betterText(existingLead.accountBrand, values.brand);

  if (existingLead.accountBrand && norm(existingLead.accountBrand) !== norm(existingLead.company)) {
    existingLead.accountSummary = betterText(existingLead.accountSummary, `${existingLead.accountBrand} | Legal entity: ${existingLead.company}`);
  } else {
    existingLead.accountSummary = betterText(existingLead.accountSummary, existingLead.company);
  }

  const mergedChannels = parseChannelSet(existingLead.channel);
  (values.channelSet || new Set()).forEach((ch) => mergedChannels.add(ch));
  channelSetFromContactFields(values).forEach((ch) => mergedChannels.add(ch));
  existingLead.channel = channelSetToStorage(mergedChannels);

  if (!text(existingLead.source).trim()) {
    existingLead.source = values.source || "Image OCR";
  }

  return before !== JSON.stringify(existingLead);
}

function buildLeadFromOcr(values) {
  const id = nextLeadId();
  const company = values.company || "Unnamed Company";
  const brand = text(values.brand).trim();
  const name = values.name || `New Contact ${id}`;
  const city = values.city;
  const state = values.state ? values.state.toUpperCase() : "";
  const cityState = composeCityState(city, state);
  const channel = channelSetToStorage(values.channelSet);
  const insight = values.insight || "Imported from image OCR";
  const accountSummary =
    brand && norm(brand) !== norm(company)
      ? `${brand} | Legal entity: ${company}`
      : company;

  return {
    id,
    company,
    name,
    role: values.role,
    status: STATUS.includes(values.status) ? values.status : "New",
    priority: PRIORITY.includes(values.priority) ? values.priority : "Medium",
    createdDate: todayIso(),
    nextAction: "",
    nextActionDate: "",
    channel,
    owner: insight,
    source: values.source || "Image OCR",
    sharePointId: "",
    possibleDuplicate: "",
    email: values.email,
    phone: values.phone,
    linkedin: values.linkedin,
    location: "",
    department: "",
    notes: values.ocrText,
    accountSummary,
    accountBrand: brand,
    accountSector: "",
    accountCityState: cityState,
    accountSize: "",
    accountRevenue: "",
    accountWebsite: values.website,
    accountPhone: values.phone,
    accountCnpj: "",
    accountCity: city,
    accountState: state,
  };
}

async function addLeadFromOcrModal() {
  const values = collectOcrFormValues();
  if (!values.company) {
    alert("Company is required.");
    return;
  }
  if (!values.name) {
    alert("Contact name is required.");
    return;
  }

  const dup = findOcrDuplicates(values);
  const dupMatch = findBestOcrDuplicate(values, dup);
  if (dupMatch.reason === "name-ambiguous") {
    const top = dupMatch.ambiguous
      .slice(0, 5)
      .map((lead) => `ID ${lead.id}: ${lead.name} - ${lead.company}`)
      .join("\n");
    alert(
      `Found multiple contacts with the same name.\n` +
        `No automatic merge was made to avoid wrong updates.\n\n` +
        `${top}${dupMatch.ambiguous.length > 5 ? `\n...and ${dupMatch.ambiguous.length - 5} more` : ""}`
    );
  }
  if (dupMatch.lead) {
    const confirmMerge = confirm(
      `Duplicate detected by ${dupMatch.reason}.\n` +
        `Existing ID: ${dupMatch.lead.id} (${dupMatch.lead.name} - ${dupMatch.lead.company}).\n\n` +
        "Do you want to update this existing contact instead of creating a new one?"
    );
    if (confirmMerge) {
      const changed = mergeLeadFromOcr(dupMatch.lead, values);
      persist();
      markDbDirty();
      refresh();
      closeOcrModal();
      if (changed) {
        const syncNow = confirm(`Duplicate merged into ID ${dupMatch.lead.id}. Sync this update to DB now?`);
        if (syncNow) {
          await syncChangesToDb();
        } else {
          setMsg(`Duplicate merged into ID ${dupMatch.lead.id}. DB sync pending.`, "#b36b00");
        }
      } else {
        setMsg(`Duplicate found (ID ${dupMatch.lead.id}). No new information to merge.`, "#1f6d41");
      }
      return;
    }
  }

  const warnings = [];
  if (dup.sameName.length) warnings.push(`- Duplicate name: ${dup.sameName.length}`);
  if (dup.sameNameCompany.length) warnings.push(`- Duplicate name + company: ${dup.sameNameCompany.length}`);
  if (dup.sameEmail.length) warnings.push(`- Duplicate email: ${dup.sameEmail.length}`);
  if (dup.samePhone.length) warnings.push(`- Duplicate phone: ${dup.samePhone.length}`);
  if (warnings.length) {
    const proceedDup = confirm(
      `Possible duplicate detected:\n${warnings.join("\n")}\n\nDo you want to continue and create this contact anyway?`
    );
    if (!proceedDup) return;
  }

  const newLead = buildLeadFromOcr(values);
  const companyExists = dup.sameCompanyCount > 0;
  const confirmCreate = confirm(
    `Create new contact "${newLead.name}" in company "${newLead.company}"?\n` +
      `${companyExists ? "Company already exists in DB." : "Company will be instantiated in DB via this new contact row."}`
  );
  if (!confirmCreate) return;

  leads.push(newLead);
  persist();
  markDbDirty();
  refresh();
  closeOcrModal();

  const syncNow = confirm("Contact created. Sync this change to DB file now?");
  if (syncNow) {
    await syncChangesToDb();
  } else {
    setMsg("Contact created in dashboard. DB sync pending.", "#b36b00");
  }
}

function loadData() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      if (!INITIAL_DATA_VERSION) return JSON.parse(raw);
      const cachedVersion = text(localStorage.getItem(DATA_VERSION_KEY));
      if (cachedVersion === INITIAL_DATA_VERSION) return JSON.parse(raw);
    }
  } catch (_) {}
  try {
    if (INITIAL_DATA_VERSION) localStorage.setItem(DATA_VERSION_KEY, INITIAL_DATA_VERSION);
  } catch (_) {}
  return INITIAL_DATA;
}

function persist() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(leads));
  if (INITIAL_DATA_VERSION) localStorage.setItem(DATA_VERSION_KEY, INITIAL_DATA_VERSION);
}

function normalizeDate(s) {
  if (!s) return null;
  const str = text(s).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return new Date(`${str}T00:00:00`);
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(str)) {
    const [d, m, y] = str.split("/");
    return new Date(`${y}-${m}-${d}T00:00:00`);
  }
  const dt = new Date(str);
  return Number.isNaN(dt.valueOf()) ? null : new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
}

function isOverdue(item) {
  const d = normalizeDate(item.nextActionDate);
  if (!d) return false;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return d < today && item.status !== "Client";
}

function fillSelect(selectEl, options, firstLabel) {
  if (!selectEl) return;
  selectEl.innerHTML = "";
  const first = document.createElement("option");
  first.value = "";
  first.textContent = firstLabel;
  selectEl.appendChild(first);
  options.forEach((value) => {
    const op = document.createElement("option");
    op.value = value;
    op.textContent = value;
    selectEl.appendChild(op);
  });
}

function fillSelectFromItems(selectEl, items, firstLabel) {
  if (!selectEl) return;
  selectEl.innerHTML = "";
  const first = document.createElement("option");
  first.value = "";
  first.textContent = firstLabel;
  selectEl.appendChild(first);
  (items || []).forEach((item) => {
    const op = document.createElement("option");
    op.value = text(item.value);
    op.textContent = text(item.label || item.value);
    selectEl.appendChild(op);
  });
}

function fillFilters() {
  fillSelect(document.getElementById("fStatus"), STATUS, "Status: all");
  fillSelect(document.getElementById("fPrio"), PRIORITY, "Priority: all");
  const channels = getChannelChoices();
  fillSelect(document.getElementById("fChannel"), channels, "Channel: all");
  fillSelectFromItems(document.getElementById("fDataQuality"), DATA_QUALITY_FILTER_OPTIONS, "Data quality: all");

  fillSelect(document.getElementById("cfStatus"), STATUS, "All");
  fillSelect(document.getElementById("cfPriority"), PRIORITY, "All");
  fillSelect(document.getElementById("cfChannel"), channels, "All");
}

function getChannelChoices() {
  return ["No contact", ...CHANNEL_METHODS];
}

function duplicateKeyForLead(lead) {
  const nameKey = norm(lead?.name);
  const companyKey = norm(lead?.company);
  if (!nameKey || !companyKey) return "";
  return `${nameKey}|${companyKey}`;
}

function buildDuplicateKeySet(data) {
  const counts = new Map();
  (data || []).forEach((lead) => {
    const key = duplicateKeyForLead(lead);
    if (!key) return;
    counts.set(key, (counts.get(key) || 0) + 1);
  });
  return new Set([...counts.entries()].filter(([, count]) => count > 1).map(([key]) => key));
}

function paginateRows(rows) {
  const total = rows.length;
  const size = Number(pageSize) || 0;
  if (size <= 0) {
    currentPage = 1;
    return { rows, total, totalPages: 1, page: 1, start: total ? 1 : 0, end: total };
  }
  const totalPages = Math.max(1, Math.ceil(total / size));
  currentPage = Math.min(Math.max(currentPage, 1), totalPages);
  const startIndex = (currentPage - 1) * size;
  const pageRows = rows.slice(startIndex, startIndex + size);
  return {
    rows: pageRows,
    total,
    totalPages,
    page: currentPage,
    start: total ? startIndex + 1 : 0,
    end: startIndex + pageRows.length,
  };
}

function getColumnFilters() {
  return {
    id: norm(document.getElementById("cfId")?.value),
    company: norm(document.getElementById("cfCompany")?.value),
    cityState: norm(document.getElementById("cfCityState")?.value),
    name: norm(document.getElementById("cfName")?.value),
    role: norm(document.getElementById("cfRole")?.value),
    status: norm(document.getElementById("cfStatus")?.value),
    priority: norm(document.getElementById("cfPriority")?.value),
    createdDate: norm(document.getElementById("cfCreatedDate")?.value),
    nextAction: norm(document.getElementById("cfNextAction")?.value),
    date: norm(document.getElementById("cfDate")?.value),
    channel: norm(document.getElementById("cfChannel")?.value),
    leadInsight: norm(document.getElementById("cfLeadInsight")?.value),
  };
}

function matchesColumnFilters(lead, f) {
  if (f.id && !norm(lead.id).includes(f.id)) return false;
  if (f.company && !norm(lead.company).includes(f.company)) return false;
  if (f.cityState && !norm(lead.cityState || cityStateFromLead(lead)).includes(f.cityState)) return false;
  if (f.name && !norm(lead.name).includes(f.name)) return false;
  if (f.role && !norm(lead.role).includes(f.role)) return false;
  if (f.status && norm(lead.status) !== f.status) return false;
  if (f.priority && norm(lead.priority) !== f.priority) return false;
  if (f.createdDate && !norm(lead.createdDate).includes(f.createdDate)) return false;
  if (f.nextAction && !norm(lead.nextAction).includes(f.nextAction)) return false;
  if (f.date && !norm(lead.nextActionDate).includes(f.date)) return false;
  if (f.channel && !leadMatchesChannel(lead, f.channel)) return false;
  if (f.leadInsight && !norm(lead.owner).includes(f.leadInsight)) return false;

  return true;
}

function filtered() {
  const q = norm(document.getElementById("q").value);
  const fs = document.getElementById("fStatus").value;
  const fp = document.getElementById("fPrio").value;
  const fc = document.getElementById("fChannel").value;
  const fdq = document.getElementById("fDataQuality")?.value || "";
  const colFilters = getColumnFilters();

  return leads.filter((lead) => {
    const txt = [lead.name, lead.company, cityStateFromLead(lead), lead.role, lead.owner, lead.nextAction].map((v) => norm(v)).join(" ");
    if (q && !txt.includes(q)) return false;
    if (fs && lead.status !== fs) return false;
    if (fp && lead.priority !== fp) return false;
    if (fc && !leadMatchesChannel(lead, fc)) return false;
    if (!matchesDataQualityFilter(lead, fdq)) return false;
    if (onlyOverdue && !isOverdue(lead)) return false;
    if (!matchesColumnFilters(lead, colFilters)) return false;
    return true;
  });
}

function renderKPIs(data) {
  const uniqueCompanies = new Set(data.map((l) => norm(l.company)).filter(Boolean)).size;
  const directContact = data.filter((l) => parseChannelSet(l.channel).size > 0).length;
  const contactCoverage = data.length ? Math.round((directContact / data.length) * 100) : 0;
  const duplicateNameCompanyKeys = buildDuplicateKeySet(data).size;
  const missingContact = data.filter((l) => !hasDirectContactInfo(l)).length;
  const missingCnpj = data.filter((l) => !hasCompanyCnpj(l)).length;

  const kpis = [
    ["Total Leads", data.length],
    ["Unique Companies", uniqueCompanies],
    ["High Priority", data.filter((l) => l.priority === "High").length],
    ["In Contact", data.filter((l) => l.status === "In Contact").length],
    ["Meeting Scheduled", data.filter((l) => l.status === "Meeting Scheduled").length],
    ["No Contact", data.filter((l) => parseChannelSet(l.channel).size === 0).length],
    ["Direct Contact Coverage", `${contactCoverage}%`],
    ["Missing Contact Info", missingContact],
    ["Missing CNPJ", missingCnpj],
    ["Duplicate Name+Company", duplicateNameCompanyKeys],
    ["Overdue Actions", data.filter(isOverdue).length],
  ];

  document.getElementById("kpis").innerHTML = kpis
    .map(([title, value]) => `<div class="kpi"><div class="t">${title}</div><div class="v">${value}</div></div>`)
    .join("");
}

function daysUntilDate(dateValue) {
  const dt = normalizeDate(dateValue);
  if (!dt) return Number.POSITIVE_INFINITY;
  const now = new Date();
  now.setHours(0, 0, 0, 0);
  return Math.round((dt.getTime() - now.getTime()) / 86400000);
}

function rankingLabel(score) {
  if (score >= 78) return "Critical";
  if (score >= 68) return "High";
  if (score >= 56) return "Medium";
  return "Low";
}

function rankingScore(lead) {
  let score = 34;
  const priority = text(lead.priority).trim();
  const status = text(lead.status).trim();
  const dueDays = daysUntilDate(lead.nextActionDate);
  const channelCount = parseChannelSet(lead.channel).size;

  if (priority === "High") score += 28;
  else if (priority === "Medium") score += 18;
  else if (priority === "Low") score += 10;

  if (status === "Proposal Sent") score += 16;
  else if (status === "Meeting Scheduled") score += 13;
  else if (status === "In Contact") score += 10;
  else if (status === "New") score += 6;
  else if (status === "Discarded") score -= 10;

  if (dueDays < 0) score += 18;
  else if (Number.isFinite(dueDays) && dueDays <= 3) score += 14;
  else if (Number.isFinite(dueDays) && dueDays <= 7) score += 11;
  else if (Number.isFinite(dueDays) && dueDays <= 14) score += 8;
  else if (Number.isFinite(dueDays)) score += 3;

  if (channelCount >= 3) score += 10;
  else if (channelCount === 2) score += 8;
  else if (channelCount === 1) score += 5;
  else score += 1;

  if (hasCompanyCnpj(lead)) score += 6;
  if (text(lead.email).trim() || text(lead.phone).trim() || text(lead.linkedin).trim()) score += 6;
  if (text(lead.accountSummary).trim()) score += 4;

  return Math.max(0, Math.min(99, score));
}

function renderCompanyRanking(data) {
  const listEl = document.getElementById("companyRankingList");
  const subEl = document.getElementById("companyRankingSub");
  if (!listEl || !subEl) return;

  const activeLeads = (data || []).filter((lead) => {
    const status = text(lead.status).trim();
    return status !== "Client" && status !== "Discarded";
  });

  if (!activeLeads.length) {
    subEl.textContent = "No active companies in current filters";
    listEl.innerHTML = '<div class="ranking-empty">No active records match current filters.</div>';
    return;
  }

  const grouped = new Map();
  activeLeads.forEach((lead) => {
    const companyName = text(lead.company).trim() || "Unnamed Company";
    const key = norm(companyName) || `company-${lead.id}`;
    if (!grouped.has(key)) grouped.set(key, { company: companyName, leads: [] });
    grouped.get(key).leads.push(lead);
  });

  const ranked = [...grouped.values()]
    .map((group) => {
      const leadsByScore = [...group.leads]
        .map((lead) => ({ lead, score: rankingScore(lead) }))
        .sort((a, b) => b.score - a.score || daysUntilDate(a.lead.nextActionDate) - daysUntilDate(b.lead.nextActionDate));
      const best = leadsByScore[0];
      const nextDate = earliestDateText(group.leads.map((lead) => lead.nextActionDate));
      const segment = firstNonEmpty(group.leads, "accountSector") || "-";
      const briefing = firstNonEmpty(group.leads, "accountSummary");
      const topContact = text(best?.lead?.name).trim() || "-";
      return {
        company: group.company,
        contacts: group.leads.length,
        topContact,
        segment,
        score: best?.score || 0,
        label: rankingLabel(best?.score || 0),
        nextDate,
        briefing,
      };
    })
    .sort((a, b) => b.score - a.score || b.contacts - a.contacts || a.company.localeCompare(b.company, "en", { sensitivity: "base" }))
    .slice(0, 10);

  subEl.textContent = `${ranked.length} of ${grouped.size} companies shown`;
  listEl.innerHTML = ranked
    .map(
      (item) => `
      <div class="ranking-item">
        <div>
          <div class="ranking-company">${escHtml(item.company)}</div>
          <div class="ranking-meta">${item.contacts} open lead(s) - Top contact: ${escHtml(item.topContact)}</div>
        </div>
        <div class="ranking-segment">${escHtml(item.segment)}</div>
        <div><span class="rank-badge ${escAttr(item.label.toLowerCase())}">${escHtml(item.label)} ${item.score}</span></div>
        <div class="ranking-next">Next: ${escHtml(item.nextDate || "-")}</div>
        <div class="ranking-briefing">${escHtml(item.briefing || "No briefing yet")}</div>
      </div>`
    )
    .join("");
}

function pClass(p) {
  return p === "High" ? "high" : p === "Medium" ? "medium" : "low";
}

function renderKanban(data) {
  const box = document.getElementById("kanban");
  box.innerHTML = "";

  KANBAN_STATUS.forEach((status) => {
    const arr = data.filter((l) => l.status === status);
    const lane = document.createElement("div");
    lane.className = "lane";
    lane.innerHTML = `<div class="head"><span>${status}</span><span>${arr.length}</span></div><div class="list"></div>`;
    const list = lane.querySelector(".list");

    arr.slice(0, 40).forEach((l) => {
      list.insertAdjacentHTML(
        "beforeend",
        `<div class="card">
          <div class="name"><button class="contact-link" type="button" data-open-contact="${escAttr(l.id)}">${escHtml(l.name || "(No name)")}</button> - <button class="company-link" type="button" data-open-company="${escAttr(l.company || "")}">${escHtml(l.company || "")}</button></div>
          <div class="meta">${escHtml(l.role || "")}</div>
          <span class="pill ${pClass(l.priority)}">${escHtml(l.priority || "No priority")}</span>
          <div class="meta" style="margin-top:4px">${l.nextActionDate ? `Next: ${escHtml(l.nextActionDate)}` : "No date"}${isOverdue(l) ? " - OVERDUE" : ""}</div>
        </div>`
      );
    });

    box.appendChild(lane);
  });
}

function renderAgenda(data) {
  const arr = [...data]
    .filter(isOverdue)
    .sort((a, b) => text(a.nextActionDate).localeCompare(text(b.nextActionDate)))
    .slice(0, 12);
  const el = document.getElementById("agenda");

  el.innerHTML = arr.length
    ? arr
        .map(
          (l) =>
            `<div class="agenda-item"><strong>${escHtml(l.name)}</strong> - ${escHtml(l.company)} - ${escHtml(
              l.nextActionDate || "no date"
            )} - ${escHtml(l.nextAction || "no action")}</div>`
        )
        .join("")
    : '<div class="agenda-item">No overdue actions in current filters.</div>';
}

function stOpts(selected) {
  return STATUS.map((s) => `<option ${s === selected ? "selected" : ""}>${s}</option>`).join("");
}

function prOpts(selected) {
  return PRIORITY.map((s) => `<option ${s === selected ? "selected" : ""}>${s}</option>`).join("");
}

function renderChannelEditor(rawValue) {
  const selected = parseChannelSet(rawValue);
  return `<div class="channel-multi">${CHANNEL_METHODS.map(
    (method) =>
      `<label class="channel-option"><input type="checkbox" data-k="channelMethod" data-method="${method}" ${
        selected.has(method) ? "checked" : ""
      } /><span>${method}</span></label>`
  ).join("")}</div>`;
}

function parseDateForSort(value) {
  const d = normalizeDate(value);
  return d ? d.getTime() : Number.POSITIVE_INFINITY;
}

function priorityRank(priority) {
  if (priority === "High") return 0;
  if (priority === "Medium") return 1;
  if (priority === "Low") return 2;
  return 3;
}

function firstNumericId(value) {
  const match = text(value).match(/\d+/);
  return match ? Number(match[0]) : Number.POSITIVE_INFINITY;
}

function sortValue(item, key) {
  switch (key) {
    case "id":
      return operationalMode === "companies" ? firstNumericId(item.id) : Number(item.id) || Number.POSITIVE_INFINITY;
    case "company":
      return norm(item.company);
    case "cityState":
      return norm(item.cityState || cityStateFromLead(item));
    case "name":
      return norm(item.name);
    case "role":
      return norm(item.role);
    case "status": {
      const idx = STATUS.indexOf(text(item.status).trim());
      return idx >= 0 ? idx : Number.POSITIVE_INFINITY;
    }
    case "priority":
      return priorityRank(text(item.priority).trim());
    case "createdDate":
      return parseDateForSort(item.createdDate);
    case "nextAction":
      return norm(item.nextAction);
    case "date":
      return parseDateForSort(item.nextActionDate);
    case "channel": {
      const count = parseChannelSet(item.channel).size;
      return `${String(count).padStart(2, "0")}|${norm(item.channel)}`;
    }
    case "leadInsight":
      return norm(item.owner);
    default:
      return "";
  }
}

function compareSort(a, b, key) {
  const av = sortValue(a, key);
  const bv = sortValue(b, key);
  if (typeof av === "number" && typeof bv === "number") {
    if (av < bv) return -1;
    if (av > bv) return 1;
  } else {
    const cmp = text(av).localeCompare(text(bv), "en", { numeric: true, sensitivity: "base" });
    if (cmp !== 0) return cmp;
  }
  const byCompany = text(a._companyName || a.company).localeCompare(text(b._companyName || b.company), "en", { numeric: true, sensitivity: "base" });
  if (byCompany !== 0) return byCompany;
  return text(a.name).localeCompare(text(b.name), "en", { numeric: true, sensitivity: "base" });
}

function applySort(rows) {
  if (!sortKey || !sortDir) return rows;
  const sorted = [...rows].sort((a, b) => compareSort(a, b, sortKey));
  return sortDir === 1 ? sorted : sorted.reverse();
}

function toggleSort(key) {
  if (sortKey !== key) {
    sortKey = key;
    sortDir = 1;
  } else if (sortDir === 1) {
    sortDir = -1;
  } else if (sortDir === -1) {
    sortKey = "";
    sortDir = 0;
  } else {
    sortDir = 1;
  }
  currentPage = 1;
  refresh();
}

function pickPrimaryLead(groupLeads) {
  return [...groupLeads].sort((a, b) => {
    const overdueA = isOverdue(a) ? 0 : 1;
    const overdueB = isOverdue(b) ? 0 : 1;
    if (overdueA !== overdueB) return overdueA - overdueB;
    const prA = priorityRank(a.priority);
    const prB = priorityRank(b.priority);
    if (prA !== prB) return prA - prB;
    const dtA = parseDateForSort(a.nextActionDate);
    const dtB = parseDateForSort(b.nextActionDate);
    if (dtA !== dtB) return dtA - dtB;
    return Number(a.id || 0) - Number(b.id || 0);
  })[0];
}

function summarizeNames(groupLeads) {
  const names = [...new Set(groupLeads.map((l) => text(l.name).trim()).filter(Boolean))];
  if (!names.length) return "No named contacts";
  if (names.length <= 2) return names.join(" | ");
  return `${names.slice(0, 2).join(" | ")} +${names.length - 2} more`;
}

function summarizeRoles(groupLeads) {
  const roles = [...new Set(groupLeads.map((l) => text(l.role).trim()).filter(Boolean))];
  if (!roles.length) return "";
  if (roles.length <= 2) return roles.join(" | ");
  return `${roles.slice(0, 2).join(" | ")} +${roles.length - 2} more`;
}

function earliestDateText(values) {
  let best = null;
  (values || []).forEach((value) => {
    const dateObj = normalizeDate(value);
    if (!dateObj) return;
    if (!best || dateObj < best) best = dateObj;
  });
  return best ? best.toISOString().slice(0, 10) : "";
}

function buildCompanyRows(data) {
  const groups = new Map();
  data.forEach((lead) => {
    const companyValue = text(lead.company).trim();
    const key = norm(companyValue) || `__no_company__${lead.id}`;
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(lead);
  });

  const rows = [...groups.values()].map((groupLeads) => {
    const primary = pickPrimaryLead(groupLeads);
    const companyLookup = text(primary.company).trim();
    const companyName = companyLookup || "Unnamed Company";
    const contactsSummary = summarizeNames(groupLeads);
    const contactIdsLabel = groupLeads
      .map((l) => Number(l.id))
      .filter((id) => Number.isFinite(id))
      .sort((a, b) => a - b)
      .join(", ");

    const unionChannels = new Set();
    groupLeads.forEach((l) => {
      parseChannelSet(l.channel).forEach((method) => unionChannels.add(method));
    });

    const cityState = groupLeads.map((lead) => cityStateFromLead(lead)).find((value) => text(value).trim()) || "";
    const createdDate = earliestDateText(groupLeads.map((lead) => lead.createdDate));
    return {
      ...primary,
      id: "",
      name: companyName,
      company: contactsSummary,
      cityState,
      createdDate,
      role: summarizeRoles(groupLeads),
      channel: channelSetToStorage(unionChannels),
      _companyLookup: companyLookup,
      _companyName: companyName,
      _contactsSummary: contactsSummary,
      _contactIdsLabel: contactIdsLabel,
      _groupLeads: groupLeads,
      _companyCount: groupLeads.length,
    };
  });

  rows.sort((a, b) => norm(a._companyName || a.name).localeCompare(norm(b._companyName || b.name)));
  rows.forEach((row, index) => {
    row.id = `COMP-${String(index + 1).padStart(3, "0")}`;
  });
  return rows;
}

function getHeaderLabels(mode) {
  const labels = {
    contacts: {
      id: "ID",
      company: "Company",
      cityState: "City / State",
      name: "Name",
      role: "Role",
      status: "Status",
      priority: "Priority",
      createdDate: "Created Date",
      nextAction: "Next Action",
      date: "Next Action Date",
      channel: "Channel",
      leadInsight: "Lead Insight",
    },
    companies: {
      id: "Company ID",
      company: "Contacts",
      cityState: "City / State",
      name: "Name",
      role: "Functional Areas",
      status: "Status",
      priority: "Priority",
      createdDate: "Created Date",
      nextAction: "Next Action",
      date: "Next Action Date",
      channel: "Channel",
      leadInsight: "Lead Insight",
    },
  };
  return labels[mode === "companies" ? "companies" : "contacts"];
}

function updateOperationalHeaders() {
  const labels = getHeaderLabels(operationalMode);

  document.querySelectorAll("thead tr.head-row th[data-col-key]").forEach((th) => {
    const key = th.getAttribute("data-col-key");
    if (!key) return;
    const base = labels[key] || text(th.textContent).trim();
    const marker = sortKey === key ? (sortDir === 1 ? " [^]" : sortDir === -1 ? " [v]" : "") : "";
    th.textContent = `${base}${marker}`;
    th.setAttribute("aria-sort", sortKey === key ? (sortDir === 1 ? "ascending" : "descending") : "none");
  });
}

function setupSortHeaders() {
  document.querySelectorAll("thead tr.head-row th[data-col-key]").forEach((th) => {
    const key = th.getAttribute("data-col-key");
    if (!key) return;
    if (th.dataset.sortInit === "1") return;
    th.dataset.sortInit = "1";
    th.dataset.sortKey = key;
    th.classList.add("sortable-th");
    th.tabIndex = 0;
    th.setAttribute("role", "button");
    th.addEventListener("click", () => {
      if (suppressHeaderClick) return;
      if (dragHappened) {
        dragHappened = false;
        return;
      }
      toggleSort(key);
    });
    th.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleSort(key);
      }
    });
  });
}

function applyColumnOrder() {
  const order = getActiveColumnOrder();
  const rows = [
    ...document.querySelectorAll("thead tr.head-row, thead tr.filter-row, tbody tr"),
  ];
  rows.forEach((row) => {
    const cells = [...row.children];
    if (!cells.length) return;

    const byKey = new Map();
    cells.forEach((cell) => {
      const key = cell.getAttribute("data-col-key");
      if (key) byKey.set(key, cell);
    });
    if (!byKey.size) return;

    const ordered = [];
    order.forEach((key) => {
      const cell = byKey.get(key);
      if (cell) ordered.push(cell);
    });
    cells.forEach((cell) => {
      if (!ordered.includes(cell)) ordered.push(cell);
    });
    ordered.forEach((cell) => row.appendChild(cell));
  });
}

function applyColumnVisibility() {
  const hidden = new Set(getActiveHiddenColumns());
  TABLE_COLUMN_KEYS.forEach((key) => {
    const hide = hidden.has(key);
    document.querySelectorAll(`[data-col-key="${key}"]`).forEach((cell) => {
      cell.style.display = hide ? "none" : "";
    });
  });
}

function renderColumnsMenu() {
  const list = document.getElementById("columnsMenuList");
  if (!list) return;
  const labels = getHeaderLabels(operationalMode);
  const hidden = new Set(getActiveHiddenColumns());

  list.innerHTML = TABLE_COLUMN_KEYS.map((key) => {
    const checked = hidden.has(key) ? "" : "checked";
    const label = labels[key] || key;
    return `<label class="columns-item"><input type="checkbox" data-columns-key="${escAttr(key)}" ${checked} /><span>${escHtml(label)}</span></label>`;
  }).join("");

  list.querySelectorAll("[data-columns-key]").forEach((el) => {
    el.addEventListener("change", (event) => {
      const key = text(event.currentTarget.getAttribute("data-columns-key")).trim();
      const nowChecked = event.currentTarget.checked;
      const currentHidden = new Set(getActiveHiddenColumns());
      if (nowChecked) currentHidden.delete(key);
      else currentHidden.add(key);

      const visibleCount = TABLE_COLUMN_KEYS.length - currentHidden.size;
      if (visibleCount < 2) {
        event.currentTarget.checked = true;
        setMsg("Keep at least 2 columns visible.", "#b36b00");
        return;
      }

      setActiveHiddenColumns([...currentHidden]);
      applyColumnVisibility();
      applyFrozenColumns();
      saveViewPreferences(true);
    });
  });
}

function applyColumnWidths() {
  if (window.matchMedia && window.matchMedia("(max-width: 1100px)").matches) {
    TABLE_COLUMN_KEYS.forEach((key) => {
      document.querySelectorAll(`[data-col-key="${key}"]`).forEach((cell) => {
        cell.style.removeProperty("width");
        cell.style.removeProperty("max-width");
        cell.style.removeProperty("min-width");
      });
    });
    return;
  }

  const widthMap = getActiveColumnWidths();
  TABLE_COLUMN_KEYS.forEach((key) => {
    const width = Number(widthMap[key]);
    const cells = document.querySelectorAll(`[data-col-key="${key}"]`);
    cells.forEach((cell) => {
      if (Number.isFinite(width) && width >= MIN_COLUMN_WIDTH) {
        const px = `${Math.round(width)}px`;
        cell.style.width = px;
        cell.style.minWidth = px;
        cell.style.maxWidth = px;
      } else {
        cell.style.removeProperty("width");
        cell.style.removeProperty("max-width");
        cell.style.removeProperty("min-width");
      }
    });
  });
}

function applyFrozenColumns() {
  document.querySelectorAll(".frozen-col").forEach((cell) => {
    cell.classList.remove("frozen-col", "frozen-edge");
    cell.style.removeProperty("left");
    cell.style.removeProperty("z-index");
  });

  if (window.matchMedia && window.matchMedia("(max-width: 1100px)").matches) return;

  const mode = operationalMode === "companies" ? "companies" : "contacts";
  const hidden = new Set(getActiveHiddenColumns());
  const freezeKeys = (DEFAULT_FROZEN_KEYS_BY_MODE[mode] || []).filter((key) => !hidden.has(key));
  if (!freezeKeys.length) return;

  const headRow = document.querySelector("thead tr.head-row");
  if (!headRow) return;
  const headCells = [...headRow.querySelectorAll("th[data-col-key]")];
  let left = 0;
  let lastFrozenKey = "";

  freezeKeys.forEach((key) => {
    const headCell = headCells.find((cell) => cell.getAttribute("data-col-key") === key);
    if (!headCell) return;
    const width = headCell.getBoundingClientRect().width || headCell.offsetWidth || 0;
    const targets = document.querySelectorAll(`[data-col-key="${key}"]`);
    targets.forEach((cell) => {
      cell.classList.add("frozen-col");
      cell.style.left = `${Math.max(0, left)}px`;
      if (cell.tagName === "TH") {
        const row = cell.parentElement?.classList.contains("head-row") ? "head" : "filter";
        cell.style.zIndex = row === "head" ? "8" : "7";
      } else {
        cell.style.zIndex = "4";
      }
    });
    left += width;
    lastFrozenKey = key;
  });

  if (lastFrozenKey) {
    document.querySelectorAll(`[data-col-key="${lastFrozenKey}"]`).forEach((cell) => cell.classList.add("frozen-edge"));
  }
}

function setupColumnResizeHandlers() {
  document.querySelectorAll("thead tr.head-row th[data-col-key]").forEach((th) => {
    if (th.dataset.resizeInit === "1") return;
    th.dataset.resizeInit = "1";

    const handle = document.createElement("span");
    handle.className = "col-resizer";
    handle.title = "Drag to resize";
    handle.addEventListener("mousedown", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const key = th.getAttribute("data-col-key");
      if (!key) return;

      const startX = event.clientX;
      const startWidth = Math.max(th.getBoundingClientRect().width || th.offsetWidth || MIN_COLUMN_WIDTH, MIN_COLUMN_WIDTH);
      suppressHeaderClick = true;

      const onMove = (moveEvent) => {
        const delta = moveEvent.clientX - startX;
        const width = Math.max(MIN_COLUMN_WIDTH, startWidth + delta);
        setActiveColumnWidth(key, width);
        applyColumnWidths();
        applyFrozenColumns();
      };
      const onUp = () => {
        document.removeEventListener("mousemove", onMove);
        document.removeEventListener("mouseup", onUp);
        saveViewPreferences(true);
        setTimeout(() => {
          suppressHeaderClick = false;
        }, 0);
      };

      document.addEventListener("mousemove", onMove);
      document.addEventListener("mouseup", onUp);
    });
    th.appendChild(handle);
  });
}

function moveColumnInOrder(sourceKey, targetKey) {
  if (!sourceKey || !targetKey || sourceKey === targetKey) return;
  const order = [...getActiveColumnOrder()];
  const sourceIdx = order.indexOf(sourceKey);
  const targetIdx = order.indexOf(targetKey);
  if (sourceIdx < 0 || targetIdx < 0) return;
  order.splice(sourceIdx, 1);
  const insertIdx = sourceIdx < targetIdx ? targetIdx - 1 : targetIdx;
  order.splice(insertIdx, 0, sourceKey);
  setActiveColumnOrder(order);
  applyColumnOrder();
  applyColumnWidths();
  applyFrozenColumns();
}

function onHeaderDragStart(event) {
  if (event.target?.closest(".col-resizer")) return;
  const key = event.currentTarget?.getAttribute("data-col-key");
  if (!key) return;
  dragColumnKey = key;
  event.dataTransfer.effectAllowed = "move";
  event.dataTransfer.setData("text/plain", key);
  event.currentTarget.classList.add("dragging");
}

function onHeaderDragOver(event) {
  event.preventDefault();
  event.dataTransfer.dropEffect = "move";
  event.currentTarget?.classList.add("drag-over");
}

function onHeaderDragLeave(event) {
  event.currentTarget?.classList.remove("drag-over");
}

function onHeaderDragEnd(event) {
  event.currentTarget?.classList.remove("dragging");
  document.querySelectorAll("thead tr.head-row th.drag-over").forEach((th) => th.classList.remove("drag-over"));
  dragColumnKey = "";
}

function onHeaderDrop(event) {
  event.preventDefault();
  const targetKey = event.currentTarget?.getAttribute("data-col-key");
  const sourceKey = dragColumnKey || event.dataTransfer.getData("text/plain");
  event.currentTarget?.classList.remove("drag-over");
  dragHappened = true;
  moveColumnInOrder(sourceKey, targetKey);
  saveViewPreferences(true);
}

function setupColumnDragHandlers() {
  document.querySelectorAll("thead tr.head-row th[data-col-key]").forEach((th) => {
    if (th.dataset.dragInit === "1") return;
    th.dataset.dragInit = "1";
    th.draggable = true;
    th.classList.add("draggable-th");
    th.addEventListener("dragstart", onHeaderDragStart);
    th.addEventListener("dragover", onHeaderDragOver);
    th.addEventListener("dragleave", onHeaderDragLeave);
    th.addEventListener("drop", onHeaderDrop);
    th.addEventListener("dragend", onHeaderDragEnd);
  });
}

function renderTable(data) {
  const tb = document.getElementById("tbody");
  tb.innerHTML = "";
  const duplicateKeySet = operationalMode === "contacts" ? buildDuplicateKeySet(data) : new Set();

  data.forEach((l) => {
    const companyGroup = Array.isArray(l._groupLeads) ? l._groupLeads : null;
    const targetLeads = companyGroup || [l];
    const rowOverdue = companyGroup ? companyGroup.some(isOverdue) : isOverdue(l);
    const cityState = text(l.cityState || cityStateFromLead(l)).trim();

    const tr = document.createElement("tr");
    if (rowOverdue) tr.classList.add("overdue");

    const nameCell = companyGroup
      ? text(l._companyLookup).trim()
        ? `<button class="company-link" type="button" data-open-company="${escAttr(l._companyLookup)}">${escHtml(l.name || "Unnamed Company")}</button>`
        : `${escHtml(l.name || "Unnamed Company")}`
      : `<button class="contact-link" type="button" data-open-contact="${escAttr(l.id)}">${escHtml(l.name || "")}</button>${
          duplicateKeySet.has(duplicateKeyForLead(l)) ? '<span class="dup-flag">Possible duplicate</span>' : ""
        }`;

    const companyCell = companyGroup
      ? `<strong>${companyGroup.length} contact${companyGroup.length > 1 ? "s" : ""}</strong><span class="company-subline">${escHtml(
          l.company || "No named contacts"
        )}</span><span class="company-subline">Contact IDs: ${escHtml(l._contactIdsLabel || "-")}</span>`
      : `<button class="company-link" type="button" data-open-company="${escAttr(l.company || "")}">${escHtml(l.company || "")}</button>`;

    tr.innerHTML = `<td data-col-key="id">${escHtml(l.id)}</td>
      <td data-col-key="company">${companyCell}</td>
      <td data-col-key="cityState">${escHtml(cityState || "-")}</td>
      <td data-col-key="name">${nameCell}</td>
      <td data-col-key="role">${escHtml(l.role || "")}</td>
      <td data-col-key="status"><select class="inline-select" data-k="status">${stOpts(l.status)}</select></td>
      <td data-col-key="priority"><select class="inline-select" data-k="priority">${prOpts(l.priority)}</select></td>
      <td data-col-key="createdDate">${escHtml(l.createdDate || "-")}</td>
      <td data-col-key="nextAction"><textarea class="inline-textarea" data-k="nextAction">${escHtml(l.nextAction || "")}</textarea></td>
      <td data-col-key="date"><input class="inline-input" data-k="nextActionDate" value="${escAttr(l.nextActionDate || "")}" /></td>
      <td data-col-key="channel">${renderChannelEditor(l.channel)}</td>
      <td data-col-key="leadInsight"><textarea class="inline-textarea" data-k="owner">${escHtml(l.owner || "")}</textarea></td>`;

    tr.querySelectorAll('[data-k]:not([data-k="channelMethod"])').forEach((inp) =>
      inp.addEventListener("change", () => {
        const key = inp.getAttribute("data-k");
        targetLeads.forEach((lead) => {
          lead[key] = inp.value;
        });
        persist();
        markDbDirty();
        refresh();
      })
    );

    tr.querySelectorAll('[data-k="channelMethod"]').forEach((inp) =>
      inp.addEventListener("change", () => {
        const selected = [...tr.querySelectorAll('[data-k="channelMethod"]:checked')].map((cb) => cb.getAttribute("data-method"));
        targetLeads.forEach((lead) => {
          lead.channel = channelSetToStorage(selected);
        });
        persist();
        markDbDirty();
        refresh();
      })
    );

    tb.appendChild(tr);
  });
}

function renderPagination(meta) {
  const info = document.getElementById("pageInfo");
  const prev = document.getElementById("btnPrevPage");
  const next = document.getElementById("btnNextPage");
  if (!info || !prev || !next) return;

  const totalPages = meta.totalPages || 1;
  const page = meta.page || 1;
  info.textContent = meta.total
    ? `Showing ${meta.start}-${meta.end} of ${meta.total} | Page ${page}/${totalPages}`
    : "No records";

  prev.disabled = page <= 1 || !meta.total;
  next.disabled = page >= totalPages || !meta.total;
}

function refresh() {
  const data = filtered();
  renderKPIs(data);
  renderCompanyRanking(data);
  renderKanban(data);
  renderAgenda(data);
  updateOperationalHeaders();
  const tableData = operationalMode === "companies" ? buildCompanyRows(data) : data;
  const sortedRows = applySort(tableData);
  const pageMeta = paginateRows(sortedRows);
  renderTable(pageMeta.rows);
  applyColumnOrder();
  applyColumnVisibility();
  applyColumnWidths();
  applyFrozenColumns();
  renderColumnsMenu();
  renderPagination(pageMeta);
}

function exportCsv() {
  const cols = ["id", "company", "cityState", "name", "role", "status", "priority", "createdDate", "nextAction", "nextActionDate", "channel", "owner", "source"];
  const lines = [cols.join(",")].concat(
    filtered().map((l) =>
      cols
        .map((k) => {
          const value = k === "cityState" ? cityStateFromLead(l) : l[k];
          return `"${text(value).replaceAll('"', '""')}"`;
        })
        .join(",")
    )
  );
  const blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8;" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "apeiron_operations_en.csv";
  a.click();
}

function headerMap(sheet, headerRow) {
  const map = {};
  for (let c = 1; c <= 120; c += 1) {
    const v = sheet.cell(headerRow, c).value();
    if (v !== undefined && v !== null && text(v).trim() !== "") map[text(v).trim()] = c;
  }
  return map;
}

function findCol(headers, names) {
  for (const name of names) if (headers[name]) return headers[name];
  return null;
}

function setv(sheet, row, col, value) {
  if (!col) return;
  sheet.cell(row, col).value(value === undefined || value === null ? "" : value);
}

function writeLeadToSheetRow(sheet, row, headers, lead) {
  const chSet = parseChannelSet(lead.channel);
  setv(sheet, row, findCol(headers, ["ID"]), lead.id);
  setv(sheet, row, findCol(headers, ["Name"]), lead.name);
  setv(sheet, row, findCol(headers, ["Company"]), lead.company);
  setv(sheet, row, findCol(headers, ["Role"]), lead.role);
  setv(sheet, row, findCol(headers, ["Department"]), lead.department);
  setv(sheet, row, findCol(headers, ["Email"]), lead.email);
  setv(sheet, row, findCol(headers, ["Phone"]), lead.phone);
  setv(sheet, row, findCol(headers, ["LinkedIn"]), lead.linkedin);
  setv(sheet, row, findCol(headers, ["Location"]), lead.location);
  setv(sheet, row, findCol(headers, ["Status"]), lead.status);
  setv(sheet, row, findCol(headers, ["Priority"]), lead.priority);
  setv(sheet, row, findCol(headers, ["Channel", "Contact Channel"]), formatChannelLabel(lead.channel));
  setv(sheet, row, findCol(headers, ["Channel Email"]), chSet.has("Email") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel Phone"]), chSet.has("Phone") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel LinkedIn"]), chSet.has("LinkedIn") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Channel WhatsApp"]), chSet.has("WhatsApp") ? "Yes" : "");
  setv(sheet, row, findCol(headers, ["Next Action"]), lead.nextAction);
  setv(sheet, row, findCol(headers, ["Next Action Date"]), lead.nextActionDate);
  setv(sheet, row, findCol(headers, ["Created Date"]), lead.createdDate);
  setv(sheet, row, findCol(headers, ["Lead Insight", "Owner", "Vendedor"]), lead.owner);
  setv(sheet, row, findCol(headers, ["Source"]), lead.source);
  setv(sheet, row, findCol(headers, ["Notes"]), lead.notes);
  setv(sheet, row, findCol(headers, ["Account_Brand", "Brand", "Marca"]), lead.accountBrand);
  setv(sheet, row, findCol(headers, ["Account_Summary"]), lead.accountSummary);
  setv(sheet, row, findCol(headers, ["Account_Sector"]), lead.accountSector);
  setv(sheet, row, findCol(headers, ["Account_City", "Account City"]), lead.accountCity);
  setv(sheet, row, findCol(headers, ["Account_State", "Account State"]), lead.accountState);
  setv(sheet, row, findCol(headers, ["Account_City_State"]), lead.accountCityState);
  setv(sheet, row, findCol(headers, ["Account_Size"]), lead.accountSize);
  setv(sheet, row, findCol(headers, ["Account_Revenue"]), lead.accountRevenue);
  setv(sheet, row, findCol(headers, ["Account_Website"]), lead.accountWebsite);
  setv(sheet, row, findCol(headers, ["Account_Phone"]), lead.accountPhone);
  setv(sheet, row, findCol(headers, ["Account_CNPJ", "CNPJ"]), lead.accountCnpj);
}

function updateById(sheet, headerRow, leadMap, options = {}) {
  const headers = headerMap(sheet, headerRow);
  const idCol = findCol(headers, ["ID"]);
  if (!idCol) return 0;
  const appendMissing = options.appendMissing === true;

  const used = sheet.usedRange();
  const maxRow = used ? used.endCell().rowNumber() : headerRow + 1;
  let updated = 0;
  let appended = 0;
  const existingIds = new Set();

  for (let r = headerRow + 1; r <= maxRow; r += 1) {
    const id = Number(sheet.cell(r, idCol).value());
    if (!Number.isFinite(id)) continue;
    existingIds.add(id);
    const lead = leadMap.get(id);
    if (!lead) continue;
    writeLeadToSheetRow(sheet, r, headers, lead);
    updated += 1;
  }

  if (appendMissing) {
    const missingLeads = [...leadMap.values()]
      .filter((lead) => Number.isFinite(Number(lead.id)) && !existingIds.has(Number(lead.id)))
      .sort((a, b) => Number(a.id) - Number(b.id));
    let targetRow = maxRow + 1;
    missingLeads.forEach((lead) => {
      writeLeadToSheetRow(sheet, targetRow, headers, lead);
      targetRow += 1;
      appended += 1;
    });
  }

  return updated + appended;
}

async function saveToExcel(file) {
  try {
    if (!window.XlsxPopulate) {
      setMsg("Spreadsheet library unavailable.", "#b71c1c");
      return;
    }
    setMsg("Processing file...", "#1f6d41");
    const arrayBuffer = await file.arrayBuffer();
    const wb = await XlsxPopulate.fromDataAsync(arrayBuffer);
    const leadMap = new Map(leads.map((l) => [Number(l.id), l]));

    let updated = 0;
    const operations = wb.sheet("Leads_Operations") || wb.sheet("Leads_Operacao");
    if (operations) updated += updateById(operations, 1, leadMap, { appendMissing: true });

    wb.sheets().forEach((sheet) => {
      const name = sheet.name();
      if (name && (name.includes("Contacts") || name.includes("Contatos"))) {
        updated += updateById(sheet, 3, leadMap, { appendMissing: false });
      }
    });

    const out = await wb.outputAsync();
    if (window.showSaveFilePicker) {
      const handle = await window.showSaveFilePicker({
        suggestedName: file.name,
        types: [
          {
            description: "Excel Workbook",
            accept: { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"] },
          },
        ],
      });
      const writable = await handle.createWritable();
      await writable.write(out);
      await writable.close();
    } else {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(out);
      a.download = file.name.replace(/\.xlsx$/i, "") + "_updated.xlsx";
      a.click();
    }
    setMsg(`Synced successfully (${updated} rows updated).`, "#1e8449");
  } catch (e) {
    console.error(e);
    setMsg("Failed to save to Excel. Please try again.", "#b71c1c");
  }
}

async function ensureDbFileHandle() {
  if (dbFileHandle) return dbFileHandle;
  if (!window.showOpenFilePicker) return null;
  const handles = await window.showOpenFilePicker({
    multiple: false,
    types: [
      {
        description: "Excel Workbook",
        accept: { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"] },
      },
    ],
  });
  dbFileHandle = handles && handles[0] ? handles[0] : null;
  return dbFileHandle;
}

function isRecoverableDbHandleError(error) {
  const name = text(error?.name).trim();
  const message = norm(error?.message);
  if (name === "NotFoundError" || name === "SecurityError") return true;
  if (name === "NotAllowedError" && message.includes("permission")) return true;
  if (message.includes("not found") || message.includes("no such file")) return true;
  return false;
}

function formatDbSyncError(error) {
  const name = text(error?.name).trim();
  const message = text(error?.message).trim();
  const full = `${name} ${message}`.trim().toLowerCase();
  if (!name && !message) return "unknown error";
  if (name === "AbortError") return "operation cancelled";
  if (name === "NotAllowedError" || full.includes("permission")) return "permission denied by browser";
  if (name === "NotFoundError" || full.includes("not found")) return "selected DB file not found (moved/renamed)";
  if (full.includes("locked") || full.includes("in use") || full.includes("being used")) return "DB file is open/locked by another app";
  return (message || name).slice(0, 120);
}

async function syncChangesToDb() {
  if (!window.XlsxPopulate || !window.showOpenFilePicker) {
    setMsg("DB sync requires a Chromium browser with file access support.", "#b36b00");
    return false;
  }

  const leadMap = new Map(leads.map((l) => [Number(l.id), l]));
  let lastError = null;

  for (let attempt = 1; attempt <= 2; attempt += 1) {
    try {
      const handle = await ensureDbFileHandle();
      if (!handle) {
        setMsg("DB file selection cancelled. Changes remain pending.", "#b36b00");
        return false;
      }

      const file = await handle.getFile();
      const arrayBuffer = await file.arrayBuffer();
      const wb = await XlsxPopulate.fromDataAsync(arrayBuffer);

      let updated = 0;
      const operations = wb.sheet("Leads_Operations") || wb.sheet("Leads_Operacao");
      if (operations) updated += updateById(operations, 1, leadMap, { appendMissing: true });

      const details = wb.sheet("Leads_Details");
      if (details) updated += updateById(details, 1, leadMap, { appendMissing: true });

      wb.sheets().forEach((sheet) => {
        const name = sheet.name();
        if (name && (name.includes("Contacts") || name.includes("Contatos"))) {
          updated += updateById(sheet, 3, leadMap, { appendMissing: false });
        }
      });

      const out = await wb.outputAsync();
      const writable = await handle.createWritable();
      await writable.write(out);
      await writable.close();
      dbDirty = false;
      setMsg(`DB updated successfully (${updated} rows).`, "#1e8449");
      return true;
    } catch (e) {
      lastError = e;
      console.error(e);
      if (attempt === 1 && dbFileHandle && isRecoverableDbHandleError(e)) {
        dbFileHandle = null;
        setMsg("DB file handle expired. Please select the DB file again...", "#b36b00");
        continue;
      }
      break;
    }
  }

  setMsg(`Failed to update DB file (${formatDbSyncError(lastError)}). Changes are still pending.`, "#b71c1c");
  return false;
}

async function saveModalChanges() {
  if (!modalState.type) return;
  const confirmSave = confirm("Confirm save these changes?");
  if (!confirmSave) return;

  const values = collectModalValues();
  if (modalState.type === "contact") {
    applyContactModalChanges(values);
  } else if (modalState.type === "company") {
    applyCompanyModalChanges(values);
  }

  persist();
  markDbDirty();
  modalState.editing = false;
  refresh();
  renderActiveModal();

  const confirmSync = confirm("Sync these changes to DB now?");
  if (!confirmSync) {
    setMsg("Changes saved in dashboard. DB sync pending.", "#b36b00");
    return;
  }
  await syncChangesToDb();
}

function resetViewToDefault() {
  operationalMode = "contacts";
  pageSize = 25;
  sortKey = "";
  sortDir = 0;
  onlyOverdue = false;
  restoredViewFilters = null;
  columnOrderByMode = {
    contacts: [...DEFAULT_COLUMN_ORDER_BY_MODE.contacts],
    companies: [...DEFAULT_COLUMN_ORDER_BY_MODE.companies],
  };
  columnWidthByMode = { contacts: {}, companies: {} };
  hiddenColumnsByMode = { contacts: [], companies: [] };

  VIEW_FILTER_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = "";
  });

  const modeEl = document.getElementById("operationalMode");
  const rowsEl = document.getElementById("rowsPerPage");
  if (modeEl) modeEl.value = "contacts";
  if (rowsEl) rowsEl.value = "25";

  const overdueBtn = document.getElementById("btnOverdue");
  if (overdueBtn) overdueBtn.textContent = "Only overdue";
  const columnsMenu = document.getElementById("columnsMenu");
  const btnColumns = document.getElementById("btnColumns");
  if (columnsMenu) {
    columnsMenu.setAttribute("data-open", "false");
    columnsMenu.setAttribute("aria-hidden", "true");
  }
  if (btnColumns) btnColumns.setAttribute("aria-expanded", "false");

  currentPage = 1;
  refresh();
  saveViewPreferences(true);
  setMsg("View reset to default.", "#1e8449");
}

function wireUi() {
  setupSortHeaders();
  setupColumnDragHandlers();
  setupColumnResizeHandlers();

  const modeEl = document.getElementById("operationalMode");
  const rowsEl = document.getElementById("rowsPerPage");
  if (modeEl) modeEl.value = operationalMode;
  if (rowsEl) rowsEl.value = String(pageSize);
  applyViewFiltersToDom(restoredViewFilters);
  document.getElementById("btnOverdue").textContent = onlyOverdue ? "Show all" : "Only overdue";
  updateModalButtons();

  const refreshFromFirstPage = () => {
    currentPage = 1;
    refresh();
  };

  document.getElementById("q").addEventListener("input", refreshFromFirstPage);
  document.getElementById("fStatus").addEventListener("change", refreshFromFirstPage);
  document.getElementById("fPrio").addEventListener("change", refreshFromFirstPage);
  document.getElementById("fChannel").addEventListener("change", refreshFromFirstPage);
  document.getElementById("fDataQuality")?.addEventListener("change", refreshFromFirstPage);
  document.getElementById("operationalMode").addEventListener("change", (event) => {
    operationalMode = event.target.value === "companies" ? "companies" : "contacts";
    currentPage = 1;
    refresh();
    saveViewPreferences(true);
  });
  document.getElementById("rowsPerPage").addEventListener("change", (event) => {
    const value = Number(event.target.value);
    pageSize = Number.isFinite(value) ? value : 25;
    currentPage = 1;
    refresh();
    saveViewPreferences(true);
  });
  document.getElementById("btnPrevPage").addEventListener("click", () => {
    currentPage = Math.max(1, currentPage - 1);
    refresh();
  });
  document.getElementById("btnNextPage").addEventListener("click", () => {
    currentPage += 1;
    refresh();
  });

  COLUMN_FILTER_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener("input", refreshFromFirstPage);
    el.addEventListener("change", refreshFromFirstPage);
  });

  document.getElementById("btnOverdue").addEventListener("click", () => {
    onlyOverdue = !onlyOverdue;
    document.getElementById("btnOverdue").textContent = onlyOverdue ? "Show all" : "Only overdue";
    currentPage = 1;
    refresh();
  });
  document.getElementById("btnExport").addEventListener("click", exportCsv);
  document.getElementById("btnSaveView").addEventListener("click", () => saveViewPreferences(false));
  document.getElementById("btnResetView").addEventListener("click", resetViewToDefault);
  const btnColumns = document.getElementById("btnColumns");
  const columnsMenu = document.getElementById("columnsMenu");
  if (btnColumns && columnsMenu) {
    btnColumns.addEventListener("click", (event) => {
      event.stopPropagation();
      const open = columnsMenu.getAttribute("data-open") === "true";
      columnsMenu.setAttribute("data-open", open ? "false" : "true");
      columnsMenu.setAttribute("aria-hidden", open ? "true" : "false");
      btnColumns.setAttribute("aria-expanded", open ? "false" : "true");
      if (!open) renderColumnsMenu();
    });
    document.addEventListener("click", (event) => {
      if (event.target.closest("#columnsMenu") || event.target.closest("#btnColumns")) return;
      columnsMenu.setAttribute("data-open", "false");
      columnsMenu.setAttribute("aria-hidden", "true");
      btnColumns.setAttribute("aria-expanded", "false");
    });
  }
  document.getElementById("btnSaveExcel").addEventListener("click", () => document.getElementById("excelFile").click());
  document.getElementById("excelFile").addEventListener("change", async (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    await saveToExcel(file);
    dbDirty = false;
    e.target.value = "";
  });
  const btnImportImage = document.getElementById("btnImportImage");
  if (btnImportImage) {
    btnImportImage.addEventListener("click", openOcrModal);
  }
  const ocrFile = getOcrEl("ocrFile");
  if (ocrFile) {
    ocrFile.addEventListener("change", (event) => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      setOcrImageFile(file);
      setOcrStatus("Image selected. Click 'Run OCR' or 'Run AI'.", "#1f6d41");
    });
  }
  const ocrRun = getOcrEl("ocrRun");
  if (ocrRun) {
    ocrRun.addEventListener("click", async () => {
      await runOcrFromSelectedImage();
    });
  }
  const ocrRunAi = getOcrEl("ocrRunAi");
  if (ocrRunAi) {
    ocrRunAi.addEventListener("click", async () => {
      await runAiFromSelectedImage();
    });
  }
  const ocrAdd = getOcrEl("ocrAdd");
  if (ocrAdd) {
    ocrAdd.addEventListener("click", async () => {
      await addLeadFromOcrModal();
    });
  }
  const ocrClose = getOcrEl("ocrClose");
  if (ocrClose) {
    ocrClose.addEventListener("click", closeOcrModal);
  }
  const ocrModal = getOcrEl("ocrModal");
  if (ocrModal) {
    ocrModal.addEventListener("click", (event) => {
      if (event.target && event.target.getAttribute("data-close-ocr-modal") === "true") closeOcrModal();
    });
  }
  const ocrText = getOcrEl("ocrText");
  if (ocrText) {
    ocrText.addEventListener("change", () => {
      applyOcrParsedData(parseBusinessCardText(ocrText.value));
      setOcrStatus("Fields updated from edited OCR text.", "#1f6d41");
    });
  }

  const btnEdit = document.getElementById("contactModalEdit");
  const btnSave = document.getElementById("contactModalSave");
  const btnCancel = document.getElementById("contactModalCancel");
  if (btnEdit) {
    btnEdit.addEventListener("click", () => {
      modalState.editing = true;
      renderActiveModal();
    });
  }
  if (btnSave) {
    btnSave.addEventListener("click", async () => {
      await saveModalChanges();
    });
  }
  if (btnCancel) {
    btnCancel.addEventListener("click", () => {
      modalState.editing = false;
      renderActiveModal();
    });
  }

  document.addEventListener("click", (event) => {
    const contactTarget = event.target.closest("[data-open-contact]");
    if (contactTarget) {
      openContactModal(contactTarget.getAttribute("data-open-contact"));
      return;
    }

    const companyTarget = event.target.closest("[data-open-company]");
    if (companyTarget) {
      const company = companyTarget.getAttribute("data-open-company");
      if (text(company).trim()) openCompanyModal(company);
    }
  });

  document.getElementById("contactModalClose").addEventListener("click", closeContactModal);
  document.getElementById("contactModal").addEventListener("click", (event) => {
    if (event.target && event.target.getAttribute("data-close-modal") === "true") closeContactModal();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeContactModal();
      closeOcrModal();
    }
  });

  window.addEventListener("resize", () => {
    applyFrozenColumns();
  });

  window.addEventListener("beforeunload", (event) => {
    if (!dbDirty) return;
    event.preventDefault();
    event.returnValue = "";
  });
}

loadViewPreferences();
fillFilters();
wireUi();
refresh();

